//@version=6
indicator("LiqSweep+iFVG Pro +VWAP", "LiqSweep+iFVG Pro+V", true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// Group 14 (anchored VWAP with standard-deviation bands) is a research
// add-on on top of the LiqSweep+iFVG Pro core.

// ===================================================================
// LiqSweep+iFVG Pro - session-liquidity sweep into inverted-FVG
// reversal, with order-flow and auction confluences layered on top.
// Every module is toggleable; group 00's Chart density (Minimal /
// Balanced / Full) strips the chart back without touching them.
//
// CORE
// - Sessions (NY/London/Asia) tracked as liquidity; a level dies on
//   its first touch, and a new session's level replaces the previous
//   still-live level of the same type (configurable depth).
// - On charts too short to hold older sessions (1 minute), untouched
//   levels from before the first bar are loaded from a higher-timeframe
//   scan, then swept and armed like any other level.
// - A sweep beyond a level arms a reversal for a limited window; all
//   sessions arm by default (per-session toggles). Group 03 can
//   require an EXTERNAL pool to be swept before an equal high/low
//   sweep is allowed to arm anything.
// - Trigger: a Fair Value Gap body-closed through its far edge
//   against the sweep direction. ONE inversion clears every live
//   same-direction arm. Pre-sweep gaps within the lookback are
//   eligible; sweep-leg gaps always are.
// - EQH/EQL module adapted from the public "EQ & RE" concept
//   (CantoLab). Consumed swings are pruned, active lines capped.
// - Overlays: higher-TF FVG boxes, the premium/discount dealing
//   range (group 05), Williams-fractal swing marks (group 06).
//
// ORDER FLOW AND AUCTION (need footprint data; without it these
// modules draw nothing and the rest is unaffected)
// - Group 08 volume profile: point of control and value-area edges,
//   over a rolling window, per day, or over one fixed clock window
//   (18:00-08:55 New York default) whose edges freeze at the close
//   of that window and carry into the session as levels.
// - Value-area reclaim markers: a close beyond a frozen edge that is
//   then closed back through, the failed-auction read.
// - Group 12 cumulative volume delta, rescaled into a band inside
//   the price pane, with divergence marked at confirmed swings.
//
// CONTEXT
// - Group 11 SMT divergence against a correlated market, evaluated
//   ONLY where a tracked level is swept, comparing that market's own
//   extreme over the same session (tracked bar-by-bar while the level
//   lives, so an early confirmation is not mistaken for divergence).
//   A divergence draws its own coloured SMT badge next to the sweep
//   marker, has its own alert, and is counted in the status readout.
//   The mirror case (the comparison market takes its extreme while this
//   chart's level stays untouched) and internal SMT at the group 06
//   swing marks are drawn too. None of the three arms a signal.
// - Group 09 prior day / week high, low and close as magnet lines
//   that dim once touched; group 13 percent of a typical day's range
//   already spent, one readout top-right.
//
// 2026-09-19 frame audit (11 DodgysDD videos), NOT compiled:
// - Stacked gaps: when the sweep leg leaves gaps stacked on each
//   other, the trigger needs a body close beyond the LAST one
//   (group 04 toggle, default on). Source 3C56Omm69As 18:44.
// - Pool tiers: equal highs/lows now arm by default and sweep
//   markers carry his tier letter (S/A equal, B relative equal and
//   session). Source: his printed tier list, IkTXIUDag4w 30:40.
//
// Group 16 draws the trade each signal implies: entry at the next
// bar's open, stop behind the swing the sweep ran, target at 1R by
// default, the way the VLS indicator draws them. Display only.
//
// Alerts exist for long, short, any entry, level swept and
// value-area reclaim, so the markers can be switched off entirely.
// Runs on any timeframe; defaults are sized for MNQ intraday.
// ====================================================================

grpU = "00. Appearance"
uiDensity = input.string("Balanced", "Chart density", options=["Minimal", "Balanced", "Full"], group=grpU, tooltip="One control over how much the indicator draws, so the chart can be quietened without hunting through every group.\n\nMinimal: markers and levels only. No session shading, no gap boxes, no premium/discount tint, no swing marks, no readout text.\n\nBalanced: the above plus session shading and gap boxes, with sweep markers reduced to their session tag.\n\nFull: everything, including the order-flow numbers on each sweep marker and the shallow-touch markers.\n\nThis can only take things away. Anything switched off in its own group stays off.")

showStatus_i = input.bool(true, "Show status readout", group=grpU, tooltip="Two lines in the bottom-left corner. The first says how many older untouched session levels were loaded onto this chart, and the oldest one. The second says how many level sweeps carried SMT against the comparison market, or NO DATA when that feed delivered nothing, so a module that never prints can be told apart from one that is broken.")

bool dMin  = uiDensity == "Minimal"
bool dFull = uiDensity == "Full"

grpS = "01. Sessions (America/New_York)"
useNY  = input.bool(true,  "NY levels",     inline="1", group=grpS, tooltip="Track the New York session's high and low as liquidity levels. The session window is set in the field to the right.")
nySess = input.session("0930-1600", "",     inline="1", group=grpS)
useLO  = input.bool(true,  "London levels", inline="2", group=grpS, tooltip="Track the London session's high and low as liquidity levels.")
loSess = input.session("0300-0930", "",     inline="2", group=grpS)
useAS  = input.bool(true,  "Asia levels",   inline="3", group=grpS, tooltip="Track the Asia session's high and low as liquidity levels. 20:00-01:00 crosses midnight; that is handled.")
asSess = input.session("2000-0100", "",     inline="3", group=grpS)
armNY = input.bool(true,  "NY sweeps arm",     inline="a1", group=grpS, tooltip="Which sessions' levels can ARM a reversal. This is SEPARATE from tracking above: a session stays tracked (its high/low still counts as a draw-on-liquidity pool) even when its sweeps do not arm.\n\nAll sessions arm by default; narrow this to focus the signal on the session levels you care about.")
armLO = input.bool(true,  "London sweeps arm", inline="a1", group=grpS)
armAS = input.bool(true,  "Asia sweeps arm",   inline="a1", group=grpS)
showBoxes_i = input.bool(true, "Show session boxes", group=grpS, tooltip="Shade each session as a box whose top/bottom grow with the session's high/low while it is running, then freeze. Colors follow the per-session color inputs below.")
sessTransp = input.int(85, "Session box transparency", minval=0, maxval=100, group=grpS, tooltip="Fill transparency of the session boxes: 0 = solid, 100 = invisible. The session tag text is drawn a step more opaque than the fill.")
maxDays   = input.int(90, "Keep drawings for N sessions per type", minval=1, group=grpS, tooltip="History depth. Older session boxes and level lines beyond this count are deleted per session type, keeping the chart readable and under TradingView's drawing limits.")

grpL = "02. Levels (liquidity lines)"
showLevels = input.bool(true, "Show level lines", group=grpL, tooltip="Each completed session leaves two horizontal lines: its high and its low. A line extends forward until its FIRST touch in ANY later session, then freezes with a label. Touched once = gone forever; it can never be a target again. A new session's level also replaces still-live older levels of the same type beyond the configured live depth below.")
showRaidLabels = input.bool(true, "Show sweep markers", group=grpL, tooltip="'SWEEP <tag>' marks a take-out that armed the reversal (price traded beyond the level by at least the sweep buffer). 'hit <tag>' marks a touch too shallow to arm; the level still dies.")
labSize = input.string("Normal", "Label text size", options=["Tiny", "Small", "Normal", "Large"], group=grpL, tooltip="Text size for the SWEEP / hit markers and the entry signal labels. The order-flow readout on a sweep label is two lines of numbers, so Tiny is unreadable on a large monitor.")
sigStyle = input.string("Badge", "Entry marker style", options=["Text", "Badge"], group=grpL, tooltip="Text draws the word alone in the signal colour, with the triangle on the bar as the precise entry mark. Badge draws the older filled speech bubble, which is heavier and covers the candles behind it.")
labSz  = labSize == "Tiny" ? size.tiny : labSize == "Small" ? size.small : labSize == "Large" ? size.large : size.normal
liveDepth = input.int(10, "Untouched levels kept live per session type", minval=1, maxval=100, group=grpL, tooltip="1 = strict replacement: each new session's level REPLACES the previous still-live level of the same type, so only the newest untouched high/low per session type can be swept.\n\nRaise to N to keep the last N sessions' untouched levels live simultaneously, so an older pool that was never touched can still be swept days later.\n\nValues above 1 generate additional signals beyond the default model. Levels older than 'Keep drawings for N sessions' are deleted regardless, so keep that input at or above this one.")

dpOn = input.bool(true, "Load untouched levels from before the chart starts", group=grpL, tooltip="A chart only holds your plan's bar limit (20,000 bars on Premium). On a 1-minute MNQ chart that is about three weeks, so a session level from a month ago never exists on it and its sweep can never print, even though the same sweep shows on 5 or 15 minutes.\n\nWith this on, the same session tracking runs on the scan timeframe below, which reaches much further back, and every level still untouched when this chart's history begins is added once. From then on it is tracked, swept and armed like any other level, and its sweep marker carries the date it was made.\n\nThe status readout shows how many were loaded and the oldest. Loaded levels carry no SMT reading: the comparison market's matching extreme is not scanned.")
dpTf = input.string("15", "Scan timeframe for older levels", options=["5", "15", "30"], group=grpL, tooltip="Timeframe the older-level scan runs on. All three line up with every session edge. Higher reaches further back. Only used when the chart timeframe is lower than this; on 15 minutes and up the chart already holds months of sessions.")

grpE = "03. Sweep + trigger"
entryMode = input.string("iFVG inversion", "Trigger after a sweep", options=["iFVG inversion", "Return through level"], group=grpE, tooltip="What converts an armed sweep into an entry signal.\n\niFVG inversion: a Fair Value Gap from the sweep leg gets BODY-closed through its far edge in the reversal direction (a wick through is rejection, not inversion).\n\nReturn through level: simpler variant - the bar closes back through the raided level itself.")
sweepBufPts = input.float(0.25, "Minimum sweep beyond level (points)", minval=0, step=0.25, group=grpE, tooltip="How far past the level price must trade for the take-out to count as a sweep (arm), in POINTS (1.0 = 4 MNQ ticks).")
retTtlMin = input.int(60, "Trigger window after a sweep (minutes)", minval=1, group=grpE, tooltip="How long an armed sweep stays valid. If the trigger (inversion or return) has not happened within this window, the sweep is abandoned - no trade.")
entryWin  = input.session("0100-1500", "Active entry window (NY tz)", group=grpE, tooltip="Signals only fire inside this window (New York time). Levels and FVGs are tracked around the clock; only the ENTRY is gated.")
extFirst = input.bool(false, "External liquidity must be swept first", group=grpE, tooltip="Sequencing rule from the model: an EXTERNAL pool, meaning a session high or low, has to be taken out before the sweep of an INTERNAL level, an equal high or low, is allowed to arm anything.\n\nWith this off, any tracked level arms on its own sweep regardless of what came before. With it on, an equal high or low only arms when a session level was already swept in the same direction inside the window below.\n\nOnly affects equal highs and lows, since session levels are the external pools themselves.")
extFirstBars = input.int(60, "External sweep stays valid for N bars", minval=1, group=grpE, tooltip="How long an external sweep keeps the door open for an internal one. On a 5-minute chart 60 bars is five hours.")

grpQ = "02b. Equal highs / lows (EQH-EQL)"
useEq   = input.bool(true, "Track equal highs / lows", group=grpQ, tooltip="Adapted from the public 'EQ & RE' concept (CantoLab). A swing high is a bar whose high is the highest of the last three (1-left/1-right pivot); when a later bar comes back into a tolerance band around it, the pair is an Equal High (EQH). Same, mirrored, for lows (EQL). Equal highs/lows are resting liquidity: a cluster of stops sits just beyond them.")
eqTolPts = input.float(1.5, "Tolerance (points)", minval=0, step=0.25, group=grpQ, tooltip="How close a later touch must come to count as EQUAL, in POINTS. 1.0 pt = 4 MNQ ticks = the source script's default. A touch further than this beyond the swing BREAKS the point instead.")
eqMinGap = input.int(3, "Minimum bars before an equal match", minval=1, group=grpQ, tooltip="Bars that must pass after the swing forms before a touch inside the band counts as equal. Sooner than that and the point is treated as broken (swept), never marked equal. Source default: 3.")
eqArm   = input.bool(true, "Sweeps of EQH/EQL also arm", group=grpQ, tooltip="A take-out of an equal high/low beyond the tolerance arms a reversal exactly like a session-level sweep does, so the same iFVG trigger can fire on it.\n\nON by default since 2026-09-19: the source's printed pool tier list ranks perfect equal highs/lows S and A, above session highs/lows (B). Equal highs/lows fire far more often than session levels, so expect more signals; switch off to get the pre-09-19 behaviour. Not backtested as a default.")
showTier = input.bool(true, "Tier letter on sweep markers", group=grpQ, tooltip="Appends the source's pool tier to each sweep marker. S = exact equal highs/lows more than three candles apart. A = exact equal highs/lows one to three candles apart. B = relative equal highs/lows and previous session highs/lows. His footnote: two B pools swept together count as an A; that combination is not computed here.")
colEq   = input.color(#EF5350, "EQH/EQL color", group=grpQ)

grpF = "04. Fair Value Gaps"
minFvgPts = input.float(1.0, "Minimum FVG size (points)", minval=0, step=0.25, group=grpF, tooltip="Gaps smaller than this are ignored entirely - not drawn, not usable for inversion. 1.0 point on MNQ = 4 ticks. Set 0 to keep every true 3-bar gap.\n\nTradeoff: with a size filter, a smaller gap can be the FIRST inversion, so the signal waits for the next gap that passes the filter and fires a few bars later. 0 removes that lateness at the cost of chart noise.")
fvgFillRule = input.string("Body close through", "FVG fill rule (gap death)", options=["Body close through", "Wick through"], group=grpF, tooltip="When a gap counts as FILLED and is deleted from chart and logic.\n\nBody close through: a candle body closes beyond the far edge (matches the model; a filled gap can no longer invert later).\n\nWick through: any wick beyond the far edge kills it (matches the common FVG indicators, stricter).\n\nNote: the INVERSION signal itself always requires a body close, regardless of this setting.")
fvgLookback = input.int(30, "FVGs eligible from N bars before the sweep", minval=0, group=grpF, tooltip="Only gaps formed at most this many bars before the sweep (or any time after it, while armed) can invert into a signal. Keeps the inversion tied to the sweep leg instead of stale gaps from hours ago.")
stackReq = input.bool(true, "Require every stacked gap to invert", group=grpF, tooltip="When the sweep leg leaves two or more gaps stacked on each other, the source enters only after the candle body has closed beyond ALL of them, and puts the stop beyond all of them. ON: the trigger waits for the close beyond the last stacked gap. OFF: the first gap closed through fires (pre-09-19 behaviour).")
stackTolPts = input.float(5.0, "Stacked = edges within (points)", minval=0, step=0.25, group=grpF, tooltip="Two gaps count as stacked when the space between them is at most this many points. MWM-chosen number: on the source frame the two boxes touch.")
fvgExtBars = input.int(30, "Extend live gap boxes N bars", minval=5, group=grpF, tooltip="Visual only: how far unfilled gap boxes stretch to the right of their formation bar while alive.")
invExtBars = input.int(60, "Keep inverted gap visible N bars", minval=5, group=grpF, tooltip="After an inversion fires, the flipped gap is recolored and kept on the chart this many bars so the retest into it is visible.")
showFvg_i = input.bool(false, "Show FVG boxes", group=grpF, tooltip="Draw every live gap that passes the size filter. Green = bullish gap (support until inverted), red = bearish. Filled gaps disappear.")

grpH = "04b. Higher-timeframe FVG confluence"
htfFvgOn = input.bool(false, "Require price inside a higher-TF FVG", group=grpH, tooltip="Location confluence: a signal only fires if price has traded inside a live higher-timeframe FVG at any point from the sweep through the trigger.\n\nHigher gap timeframes filter harder: fewer signals, each backed by stronger higher-timeframe context. Off by default so the unfiltered baseline is what you see first.")
htfFvgTf = input.string("240", "Gap timeframe", options=["5", "15", "60", "240", "D"], group=grpH, tooltip="Which timeframe's gaps count. Higher = stronger filter and fewer signals.")
htfFvgShow_i = input.bool(true, "Show higher-TF gap boxes", group=grpH, tooltip="Draw each live higher-timeframe gap. Boxes disappear the bar a chart candle body closes beyond the far edge, which is the same gap-death rule the 1m gaps use.")
colHtfFvg = input.color(color.new(color.aqua, 0), "Higher-TF gap color", inline="hc", group=grpH)
htfTransp = input.int(93, "transparency", minval=0, maxval=100, inline="hc", group=grpH, tooltip="Fill transparency of the higher-TF gap boxes: 0 = solid, 100 = invisible. Border and label follow, drawn more opaque than the fill.")
grpP = "05. Macro dealing range (premium/discount)"
usePD_i      = input.bool(true, "Show premium/discount zones", group=grpP, tooltip="Shade the active dealing range: premium (upper half) and discount (lower half) around the equilibrium midpoint. The range is the highest high / lowest low over the lookback below. Judge entries against where price sits inside the range.")
pdLookback = input.int(50, "Dealing range lookback (bars)", minval=2, group=grpP, tooltip="How many bars back the dealing range looks for its high and low.")
colPdBear  = input.color(color.new(#a65c4f, 85), "Premium",  inline="pd", group=grpP, tooltip="Zone fill colors. The opacity set in the color picker is applied to the shading as-is.")
colPdBull  = input.color(color.new(#7f9a65, 85), "Discount", inline="pd", group=grpP)

grpW = "06. Swing points (fractals)"
useSwings_i = input.bool(true, "Mark swing points", group=grpW, tooltip="Williams-fractal swing marks: a high/low that is the extreme of N bars on each side. A mark is CONFIRMED N bars after the swing bar and is plotted back on it - it cannot appear in real time, by definition.")
swingN    = input.int(10, "Periods (bars each side)", minval=1, group=grpW)
colSwHi   = input.color(#26A69A, "High", inline="sw", group=grpW)
colSwLo   = input.color(#EF5350, "Low",  inline="sw", group=grpW)

grpA = "07. Footprint data"
absOn = input.bool(true, "Enable footprint data", group=grpA, tooltip="Measures order flow on the bar that sweeps a level, using TradingView's volume-footprint data.\n\nThe question it answers: when price took out the level, was the aggressive flow in the sweep direction ABSORBED, or did it keep going? Absorption is the evidence that the take-out was a stop hunt rather than a breakout.\n\nRequires a TradingView Premium or Ultimate plan and a symbol with real trade data (CME_MINI:MNQ1!, not a CFD proxy). Where footprint data is missing the readings show 'n/a' and signals fire unfiltered.")
absTicksRow = input.int(4, "Ticks per footprint row", minval=1, group=grpA, tooltip="Price granularity of the footprint. MNQ's tick is 0.25, so 4 gives one row per index point. Lower is finer and slower.")
absVaPct    = input.int(70, "Value area percent", minval=1, maxval=100, group=grpA, tooltip="Share of the bar's volume that defines the value area around the point of control. 70 is the convention.")
absImbPct   = input.int(300, "Imbalance percent", minval=100, group=grpA, tooltip="A price row counts as imbalanced when one side's volume exceeds the diagonal side by this percent. 300 means a 3-to-1 dominance.")
showStats = input.bool(false, "Show sample-size panel", group=grpA, tooltip="Counts, over the whole loaded chart, how many sweeps happened on an arming session, how many the order-flow filter let through, how many it blocked, and how many entry signals fired long and short. Use it to see whether a threshold sweep would have enough events to mean anything before running one.")

grpV = "08. Volume profile (footprint)"
vpOn = input.bool(true, "Show volume profile levels", group=grpV, tooltip="Builds a price-by-volume profile from the footprint rows of every bar in scope and draws its point of control and value-area edges. These are the auction levels price tends to return to, so they read as draw-on-liquidity targets rather than entry signals.\n\nNeeds the same Premium or Ultimate footprint access as group 07, and reuses that group's 'Ticks per footprint row' as its price granularity.")
vpScope = input.string("Rolling bars", "Profile scope", options=["Rolling bars", "Day", "Fixed window"], group=grpV, tooltip="Rolling bars: a moving window of the last N bars, so the levels always describe recent trade.\n\nDay: the profile resets at each new day, and each completed day leaves its levels behind as horizontal lines.\n\nFixed window: builds the profile over one clock window only, 18:00 to 08:55 New York by default, meaning the overnight auction from the new-day open to just before the cash open. Its value-area edges freeze when the window closes and carry into the session as levels.")
vpBars = input.int(200, "Rolling window (bars)", minval=10, group=grpV, tooltip="Window length when the scope is Rolling bars. Ignored in Day scope.")
vpWin = input.session("1800-0855", "Fixed window (New York time)", group=grpV, tooltip="Used only in Fixed window scope. 1800-0855 is the overnight auction from the new-day open to five minutes before the cash open.")
vpReclaim = input.bool(true, "Mark value-area reclaims", group=grpV, tooltip="After the fixed window closes, marks a failed auction: price closes beyond the value-area low and then closes back above it, which reads long, or closes beyond the value-area high and back below it, which reads short. This is the same close-back-through logic the sweep trigger uses, pointed at the value-area edges.")
vpVaPct = input.float(70, "Value area percent", minval=1, maxval=100, step=5, group=grpV, tooltip="Share of the profile's volume enclosed by the value area, expanded outward from the point of control. 70 is the convention.")
vpPriorDays = input.int(3, "Completed days kept", minval=0, maxval=20, group=grpV, tooltip="In Day scope, how many finished days keep their point of control and value-area lines on the chart. An untouched prior point of control is a magnet; set 0 to hide them.")
colPoc = input.color(#FFB74D, "Point of control", inline="vp", group=grpV)
colVa  = input.color(#78909C, "Value area edges", inline="vp", group=grpV)

grpM = "11. SMT divergence (correlated market)"
smtOn = input.bool(true, "Show SMT divergence", group=grpM, tooltip="Compares this chart against a correlated market. When MNQ takes out a recent low and the comparison market does NOT take out its own, the sweep was one index acting alone rather than the whole market turning, which is the classic non-confirmation.\n\nUses ordinary price data, so it needs no footprint, no Level 2 and no data subscription beyond the comparison symbol itself.")
smtSym = input.symbol("CME_MINI:ES1!", "Comparison symbol", group=grpM, tooltip="The correlated market. ES, the S&P 500 future, is the standard SMT pair for NQ and MNQ. MES quotes the same index at the same prices but trades thinner overnight, so its wicks are less reliable as a reference. YM tracks the Dow if you want a wider spread between the two.")
smtTf = input.string("Chart", "Comparison timeframe", options=["Chart", "1", "5", "15", "60"], group=grpM, tooltip="Chart follows whatever timeframe you are on, so the comparison stays aligned when you switch between 1 and 5 minutes. Pin it to a fixed timeframe to read the divergence from one resolution regardless of the chart.")
smtRef = input.string("Session extreme", "How the comparison is made", options=["Session extreme", "Rolling bars"], group=grpM, tooltip="Session extreme is how the model is taught: at the moment a session level is swept, ask whether the comparison market exceeded ITS OWN high or low from that same session. The comparison is tied to the pool being swept.\n\nRolling bars is the cruder statistical version: whether the comparison market made a new extreme over a fixed lookback. Kept for comparison, not because any source teaches it.")
smtLook = input.int(20, "Rolling lookback (bars)", minval=3, group=grpM, tooltip="Only used when the comparison is set to Rolling bars.")
smtEsSide = input.bool(true, "Mark the comparison market sweeping alone", group=grpM, tooltip="The mirror of the sweep check. The comparison market takes out its own high or low from a tracked session while this chart's matching level is still untouched on that bar: ES took the London high, MNQ did not. Bearish at highs, bullish at lows.\n\nDrawn as a badge naming the level, with its own alert. It does not arm a signal, because this chart swept nothing.")
smtInt = input.bool(true, "Internal SMT at swing points", group=grpM, tooltip="SMT between swings inside the range, judged at the swing marks from group 06 and using that group's strength. When a swing high confirms, it is compared with the previous swing high, and the comparison market's highest high over the same bars is compared with its value at the previous swing. One made a higher high and the other did not: bearish SMT, drawn as a dotted line between the two swings. Swing lows mirror it as bullish.\n\nIt appears when the swing mark does, that many bars after the turn, and never repaints. Display and alert only: it does not arm a signal.")
smtIntKeep = input.int(20, "Internal SMT drawings kept", minval=1, maxval=100, group=grpM, tooltip="Only the newest ones stay on the chart. Swing points are frequent on low timeframes, and TradingView deletes the oldest lines once a script passes 500, which would take the session level lines with them.")
smtMark = input.bool(true, "Draw an SMT badge on the sweep", group=grpM, tooltip="Draws a filled badge in the colours below, next to the sweep marker, whenever the comparison market failed to take out its own matching extreme. With this off, the only trace is the letters SMT at the end of the sweep label.\n\nAlso has its own alert and a data-window column, and the status readout counts how many sweeps carried it.")
colSmtUp = input.color(#26A69A, "Bullish", inline="sm", group=grpM)
colSmtDn = input.color(#EF5350, "Bearish", inline="sm", group=grpM)

grpZ = "12. CVD strip (footprint)"
cvdOn = input.bool(true, "Show cumulative delta strip", group=grpZ, tooltip="Draws cumulative volume delta as a shape inside the price pane, mapped into a band at the bottom of the visible range.\n\nPine gives a script one pane, so this is the only way to see delta without a second indicator. The trade-off: the band has no axis of its own, so it reads as shape and divergence only, never as a number.")
cvdReset = input.string("Day", "Reset the running total", options=["Never", "Day", "Session"], group=grpZ, tooltip="Cumulative delta drifts without a starting point. Day restarts each new day. Session restarts at the start of the window below.")
cvdPick = input.string("New York", "Which session", options=["New York", "London", "Asia"], group=grpZ, tooltip="Used only when the reset is set to Session. New York 0930-1600, London 0300-0930, Asia 2000-0100, New York time.")
cvdWin = input.int(200, "Bars used to scale the band", minval=20, group=grpZ, tooltip="The band is rescaled against the highest and lowest delta over this many bars, so the shape stays readable as the total grows.")
cvdHeight = input.float(15, "Band height (percent of visible range)", minval=5, maxval=40, step=5, group=grpZ)
cvdDrop = input.float(8, "Band offset below price (percent of range)", minval=0, maxval=40, step=2, group=grpZ, tooltip="Pushes the whole band further below the lowest low in the scaling window, so the delta shape stops running into the candles. Raise it if price still overlaps the line.")
cvdDivPlace = input.string("Under the candle", "Divergence label placement", options=["Under the candle", "On the strip"], group=grpZ, tooltip="Under the candle puts the note below the swing bar it refers to, which is where it reads fastest. On the strip puts it on the delta line itself, next to the shape that produced it.")
cvdPivot = input.int(5, "Divergence pivot strength (bars each side)", minval=1, group=grpZ, tooltip="How many bars must sit either side of a swing for the divergence check to use it. This is deliberately separate from the swing marks in group 06 and defaults to 5, the same value the standalone CVD pane uses, so both scripts mark the same divergences.")
cvdDiv = input.bool(true, "Mark delta divergence against price", group=grpZ, tooltip="Marks a confirmed price swing high that is higher than the previous one while delta made a lower high, and the mirror case at lows. Uses the swing strength from group 06, so it appears that many bars after the turn and never repaints.")
colCvdUp = input.color(#26A69A, "Rising", inline="cv", group=grpZ)
colCvdDn = input.color(#EF5350, "Falling", inline="cv", group=grpZ)

grpY = "09. Prior day & week levels"
pdwOn = input.bool(true, "Show prior day H / L / C", group=grpY, tooltip="Yesterday's high, low and close as lines across the current day. These are the magnets a target leg aims at. A level stays bright while UNTOUCHED; the first touch dims it to dotted and tags it 'hit', so the bright ones are the draws still in play.\n\nDisplay and export only: these levels never arm a signal.")
pwkOn = input.bool(true, "Show prior week H / L / C", group=grpY, tooltip="Last week's high, low and close, same touch-dimming. Week levels survive day rollovers until touched.")
colPdw = input.color(#FFF176, "Prior day", inline="pw", group=grpY)
colPww = input.color(#A1887F, "Prior week", inline="pw", group=grpY)

grpR = "13. Range spent"
adrOn = input.bool(true, "Show range spent vs typical day", group=grpR, tooltip="Today's high-to-low range so far as a percent of the average daily range over the lookback. It answers the one question nothing else on the chart speaks to: whether a reversal still has room. A day that has already spent its typical range has less to give.\n\nDrawn as one small readout in the top-right corner, plus a data-window export for measurement.")
adrDays = input.int(10, "Average daily range lookback (days)", minval=2, maxval=60, group=grpR)

grpC = "10. Colors"
colNY = input.color(#FFB74D, "NY", inline="c", group=grpC, tooltip="Session box + level line colors per session type.")
colLO = input.color(#64B5F6, "London", inline="c", group=grpC)
colAS = input.color(#BA68C8, "Asia", inline="c", group=grpC)
colBull = input.color(#26A69A, "Bull FVG", inline="c2", group=grpC, tooltip="Fill colors for live gap boxes and the inverted-gap highlight.")
colBear = input.color(#EF5350, "Bear FVG", inline="c2", group=grpC)

grpVW = "14. VWAP"
vwapOn = input.bool(true, "Show VWAP", group=grpVW, tooltip="Volume-weighted average price from the chosen anchor, with optional standard-deviation bands. Auction context for judging a signal's location - a sweep-reversal long far above VWAP is chasing; one into VWAP from below is entering at value.\n\nDisplay and export only: VWAP never gates or arms a signal. ON by default so the value area is always on the chart; every VWAP-as-filter idea still goes through the engine test bench first, same as the killed delta-divergence filter.")
vwapAnchor = input.string("Day", "Anchor / reset", options=["Day", "Week", "NY session", "London session", "Asia session"], group=grpVW, tooltip="Where the running average restarts. Day is the classic session VWAP. The session choices reset at that session's open (windows from group 01) and keep accumulating until the next open, so the level stays on screen between sessions.")
vwapBand1 = input.bool(true,  "Band 1", inline="vb1", group=grpVW)
vwapMult1 = input.float(1.0,  "x stdev", minval=0.1, step=0.5, inline="vb1", group=grpVW)
vwapBand2 = input.bool(true,  "Band 2", inline="vb2", group=grpVW)
vwapMult2 = input.float(2.0,  "x stdev", minval=0.1, step=0.5, inline="vb2", group=grpVW)
colVwap   = input.color(#FFD54F, "VWAP", inline="vwc", group=grpVW)
colVwBand = input.color(#90A4AE, "Bands", inline="vwc", group=grpVW)

grpT = "16. Trade levels (entry / stop / target)"
tlOn = input.bool(true, "Draw entry / stop / target on each signal", group=grpT, tooltip="A signal marker says a setup fired; it does not say what the trade is. With this on, every LONG/SHORT signal also draws the three prices that define it: the entry, a stop behind the swing the sweep ran, and a target a fixed multiple of that risk away.\n\nDisplay only. Nothing in this group gates, arms or cancels a signal, so the triangles, the alerts and the sample-size counters read exactly the same with it off.")
tlEntry = input.string("Next bar open", "Entry price", options=["Next bar open", "Signal bar close"], group=grpT, tooltip="Next bar open: the fill a market order sent on the signal would actually get, which is what the entry triangle above means by 'enter next bar'. The levels appear one bar after the signal, because the open they are measured from does not exist until then.\n\nSignal bar close: draws immediately on the signal bar at its close. Faster to read while a bar is live, but it prices a fill nobody got.")
tlSlSrc = input.string("Recent swing point", "Stop anchor", options=["Recent swing point", "Signal bar wick"], group=grpT, tooltip="Recent swing point: the last confirmed fractal swing on the stop side, extended to the extreme printed since it. While price holds above that swing the stop sits on the swing itself; once the sweep trades through it the stop follows the sweep wick, so a stop is never left inside the candle that triggered the entry. The target label says which of the two the stop landed on.\n\nSignal bar wick: the trigger candle's own low (long) or high (short), the tighter and more aggressive stop.")
tlPivN = input.int(5, "Swing strength for the stop (bars each side)", minval=1, maxval=50, group=grpT, tooltip="Pivot strength used to find the stop's swing. Independent of group 06's swing marks, which are display-only and default to 10: a stop wants the nearer structure, a chart mark wants the bigger one. Raise it for stops further back and fewer, wider setups.")
tlBuf = input.int(2, "Stop buffer (ticks beyond the swing)", minval=0, group=grpT, tooltip="Ticks added beyond the swing so the stop sits behind the wick rather than exactly on it. 2 ticks is 0.5 points on MNQ.")
tlRR = input.float(1.0, "Target at N x risk (R)", minval=0.25, step=0.25, group=grpT, tooltip="Distance to the target as a multiple of the stop distance. 1.0 puts the target exactly one R away, the same distance as the stop.")
tlMaxPts = input.float(0.0, "Skip setups with risk wider than (points, 0 = off)", minval=0.0, step=5.0, group=grpT, tooltip="A swing stop can land 100+ points away after a wide sweep, which is not a trade a Combine account can take. Above 0, a setup whose stop is further than this draws no levels at all.\n\nThe signal itself still fires: the triangle, the alert and the counters are untouched, so this filter never silently changes what the indicator reports.")
tlBars = input.int(24, "Level length (bars)", minval=3, maxval=200, group=grpT, tooltip="How far forward the three lines and their zones extend from the signal bar.")
tlKeep = input.int(6, "Keep the last N setups on the chart", minval=1, maxval=40, group=grpT, tooltip="Older setups are deleted once this many newer ones exist. TradingView caps a script at 500 lines, 500 boxes and 500 labels total, shared with the level lines, gap boxes and sweep markers, so an uncapped trade history would starve them on a long chart.")
tlZones_i = input.bool(true, "Shade the risk and reward zones", group=grpT, tooltip="Fills entry-to-stop in the bear colour and entry-to-target in the bull colour, the way the VLS indicator draws them. Off leaves the three lines alone. Chart density Minimal drops the shading and keeps the lines.")
tlLabel = input.bool(true, "Price label at the target", group=grpT, tooltip="One line at the end of the levels carrying direction, entry, stop, target, the R multiple and the risk in points, plus whether the stop sat on the swing or on the sweep wick.")

// ── Density-adjusted toggles ────────────────────────────────────────
// Each drawing switch below is its own input ANDed with the density
// choice, so lowering the density can hide an element but never reveal
// one the user turned off.
bool showBoxes  = showBoxes_i  and not dMin
bool showFvg    = showFvg_i    and not dMin
bool usePD      = usePD_i      and not dMin
bool useSwings  = useSwings_i  and not dMin
bool htfFvgShow = htfFvgShow_i and not dMin
bool showStatus = showStatus_i and not dMin
bool tlZones    = tlZones_i    and not dMin


tzNY = "America/New_York"
tick = syminfo.mintick
// vertical clearance that floats event labels off the candles (~0.6 ATR,
// tick fallback while ATR warms up). Visual only.
float labPad = nz(ta.atr(14), tick * 8) * 0.6
useIfvg = entryMode == "iFVG inversion"
bodyFill = fvgFillRule == "Body close through"

inNY = useNY and not na(time(timeframe.period, nySess, tzNY))
inLO = useLO and not na(time(timeframe.period, loSess, tzNY))
inAS = useAS and not na(time(timeframe.period, asSess, tzNY))
inWin = not na(time(timeframe.period, entryWin, tzNY))

// ── SMT comparison series ───────────────────────────────────────────
// Pulled once at the top so the sweep loop below can ask, at the moment a
// level is taken out, whether the correlated market took out its own.
string smtRes = smtTf == "Chart" ? timeframe.period : smtTf
[smtHigh, smtLow] = request.security(smtSym, smtRes, [high, low], lookahead=barmerge.lookahead_off)
float cmpPriorLow  = ta.lowest(smtLow, smtLook)[1]
float cmpPriorHigh = ta.highest(smtHigh, smtLook)[1]
// short name for the badge text, ES1! from CME_MINI:ES1!
string smtShort = str.contains(smtSym, ":") ? str.split(smtSym, ":").last() : smtSym
// bars on which the comparison feed delivered a value, for the status readout
var int smtFeedBars = 0
if smtOn and not na(smtHigh)
    smtFeedBars += 1

// ── Session boxes ──────────────────────────────────────────────────
var array<box>    sbBox = array.new<box>()
var array<string> sbTag = array.new<string>()

f_newBox(string tag, color col) =>
    if showBoxes
        sbBox.push(box.new(time, high, time, low, xloc=xloc.bar_time,
             border_color=color.new(col, math.max(0, sessTransp - 35)), bgcolor=color.new(col, math.min(100, sessTransp + 3)),
             text=tag, text_color=color.new(col, math.max(sessTransp - 49, 0)), text_size=size.tiny,
             text_halign=text.align_left, text_valign=text.align_top))
        sbTag.push(tag)
        int cnt = 0
        for j = sbTag.size() - 1 to 0
            if sbTag.get(j) == tag
                cnt += 1
                if cnt > maxDays
                    box.delete(sbBox.get(j))
                    sbBox.remove(j)
                    sbTag.remove(j)
                    break

f_growBox(string tag) =>
    if showBoxes and sbTag.size() > 0
        for j = sbTag.size() - 1 to 0
            if sbTag.get(j) == tag
                box b = sbBox.get(j)
                b.set_right(time)
                b.set_top(math.max(b.get_top(), high))
                b.set_bottom(math.min(b.get_bottom(), low))
                break

// ── Level lines ────────────────────────────────────────────────────
var array<line>   lvLine = array.new<line>()
var array<string> lvTag  = array.new<string>()
var array<int>    lvSide = array.new<int>()
var array<bool>   lvLive = array.new<bool>()
var array<float>  lvPx   = array.new_float()   // level price, so logic never depends on a line object existing
var array<float>  lvCmp  = array.new_float()   // the comparison market's extreme over the same session
var array<bool>   lvCmpBrk = array.new<bool>() // comparison market exceeded its own extreme since the level went live
var array<int>    lvT    = array.new_int()     // time the level was made; dates an older pool on its sweep marker
var int chartT0 = time                          // first bar of this chart's history

f_newLevelAt(string tag, int side, float price, color col, float cmpExt, int tMade) =>
    // bookkeeping always runs; showLevels gates only the drawing, so hiding
    // the lines can never switch the sweep engine off.
    // replacement semantics: a new session's level retires still-live older
    // levels of the same tag beyond the configured live depth. liveDepth=1
    // = strict replacement: newest untouched level only (default 10 keeps
    // the last ten sessions' untouched pools sweepable).
    if lvTag.size() > 0
        int liveCnt = 0
        for j = lvTag.size() - 1 to 0
            if lvTag.get(j) == tag and lvLive.get(j)
                liveCnt += 1
                if liveCnt > liveDepth - 1
                    lvLive.set(j, false)
    lvLine.push(showLevels ? line.new(math.max(tMade, chartT0), price, time, price, xloc=xloc.bar_time, color=col, width=2) : line(na))
    lvTag.push(tag)
    lvSide.push(side)
    lvLive.push(true)
    lvPx.push(price)
    lvCmp.push(cmpExt)
    lvCmpBrk.push(false)
    lvT.push(tMade)
    int cnt = 0
    for j = lvTag.size() - 1 to 0
        if lvTag.get(j) == tag
            cnt += 1
            if cnt > maxDays
                line.delete(lvLine.get(j))
                lvLine.remove(j)
                lvTag.remove(j)
                lvSide.remove(j)
                lvLive.remove(j)
                lvPx.remove(j)
                lvCmp.remove(j)
                lvCmpBrk.remove(j)
                lvT.remove(j)
                break

f_newLevel(string tag, int side, float price, color col, float cmpExt) =>
    f_newLevelAt(tag, side, price, col, cmpExt, time)

// ── Older untouched levels (made before the chart's first bar) ─────
// A 1-minute chart holds only the plan's bar limit, so a session level
// from weeks ago never exists on it. The same session engine runs on a
// higher timeframe, where the same bar budget reaches much further back,
// and every level still untouched when this chart begins is handed to
// the chart engine once. Pools travel as flat triples: code (0 NYH,
// 1 NYL, 2 LOH, 3 LOL, 4 ASH, 5 ASL), price, time made. Touched pools are
// dropped and liveDepth retires the oldest live ones, same as on chart.
f_dpPush(array<float> a, int code, float px) =>
    int n = 0
    int k = int(a.size() / 3)
    if k > 0
        for i = k - 1 to 0
            if int(a.get(i * 3)) == code
                n += 1
                if n > liveDepth - 1
                    a.remove(i * 3 + 2)
                    a.remove(i * 3 + 1)
                    a.remove(i * 3)
    a.push(float(code))
    a.push(px)
    a.push(float(time))

// runs inside request.security: high, low, time and timeframe.period are
// the scan timeframe's. Gated by the input only, never by the chart
// timeframe, because a chart-timeframe test re-evaluates in this context.
f_deepPools(bool on) =>
    var array<float> pools = array.new_float()
    var array<float> runHi = array.new_float(3, na)
    var array<float> runLo = array.new_float(3, na)
    bool in0 = useNY and not na(time(timeframe.period, nySess, tzNY))
    bool in1 = useLO and not na(time(timeframe.period, loSess, tzNY))
    bool in2 = useAS and not na(time(timeframe.period, asSess, tzNY))
    if on
        for s = 0 to 2
            bool ins = s == 0 ? in0 : s == 1 ? in1 : in2
            if ins
                runHi.set(s, na(runHi.get(s)) ? high : math.max(runHi.get(s), high))
                runLo.set(s, na(runLo.get(s)) ? low : math.min(runLo.get(s), low))
            else if not na(runHi.get(s))
                f_dpPush(pools, s * 2, runHi.get(s))
                f_dpPush(pools, s * 2 + 1, runLo.get(s))
                runHi.set(s, na)
                runLo.set(s, na)
        int k = int(pools.size() / 3)
        if k > 0
            for i = k - 1 to 0
                float px = pools.get(i * 3 + 1)
                bool hitP = int(pools.get(i * 3)) % 2 == 0 ? high >= px : low <= px
                if hitP
                    pools.remove(i * 3 + 2)
                    pools.remove(i * 3 + 1)
                    pools.remove(i * 3)
    pools.copy()

bool dpActive = dpOn and timeframe.in_seconds() < timeframe.in_seconds(dpTf)
array<float> dpArr = request.security(syminfo.tickerid, dpActive ? dpTf : timeframe.period, f_deepPools(dpOn), lookahead=barmerge.lookahead_off)

var float  dpSeenHi = na     // this chart's own range before the list arrived
var float  dpSeenLo = na
var bool   dpDone   = false
var int    dpCnt    = 0
var string dpOldest = ""
if dpActive and not dpDone and not na(dpArr)
    dpDone := true
    array<string> dpTags = array.from("NYH", "NYL", "LOH", "LOL", "ASH", "ASL")
    int nP = int(dpArr.size() / 3)
    if nP > 0
        for i = 0 to nP - 1
            int   code  = int(dpArr.get(i * 3))
            float px    = dpArr.get(i * 3 + 1)
            int   tMade = int(dpArr.get(i * 3 + 2))
            bool  isHi  = code % 2 == 0
            // skip a pool this chart already traded through before the list arrived
            bool seen = isHi ? (not na(dpSeenHi) and dpSeenHi >= px) : (not na(dpSeenLo) and dpSeenLo <= px)
            if tMade < chartT0 and not seen
                color dpCol = code < 2 ? colNY : code < 4 ? colLO : colAS
                f_newLevelAt(dpTags.get(code), isHi ? 1 : -1, px, dpCol, na, tMade)
                dpCnt += 1
                if dpCnt == 1
                    dpOldest := dpTags.get(code) + " " + str.format_time(tMade, "MM-dd", tzNY) + " @ " + str.tostring(px, format.mintick)
dpSeenHi := na(dpSeenHi) ? high : math.max(dpSeenHi, high)
dpSeenLo := na(dpSeenLo) ? low : math.min(dpSeenLo, low)

var float nyHi = na, var float nyLo = na
var float loHi = na, var float loLo = na
var float asHi = na, var float asLo = na
// the same session windows measured on the comparison market, so a sweep can
// ask whether that market took out its own session extreme rather than ours
var float cNyHi = na, var float cNyLo = na
var float cLoHi = na, var float cLoLo = na
var float cAsHi = na, var float cAsLo = na

if inNY
    if na(nyHi)
        f_newBox("NY", colNY)
    f_growBox("NY")
    nyHi := na(nyHi) ? high : math.max(nyHi, high)
    nyLo := na(nyLo) ? low : math.min(nyLo, low)
    cNyHi := na(cNyHi) ? smtHigh : math.max(cNyHi, smtHigh)
    cNyLo := na(cNyLo) ? smtLow  : math.min(cNyLo, smtLow)
else if not na(nyHi)
    f_newLevel("NYH", 1, nyHi, colNY, cNyHi)
    f_newLevel("NYL", -1, nyLo, colNY, cNyLo)
    nyHi := na
    nyLo := na
    cNyHi := na
    cNyLo := na
if inLO
    if na(loHi)
        f_newBox("LONDON", colLO)
    f_growBox("LONDON")
    loHi := na(loHi) ? high : math.max(loHi, high)
    loLo := na(loLo) ? low : math.min(loLo, low)
    cLoHi := na(cLoHi) ? smtHigh : math.max(cLoHi, smtHigh)
    cLoLo := na(cLoLo) ? smtLow  : math.min(cLoLo, smtLow)
else if not na(loHi)
    f_newLevel("LOH", 1, loHi, colLO, cLoHi)
    f_newLevel("LOL", -1, loLo, colLO, cLoLo)
    loHi := na
    loLo := na
    cLoHi := na
    cLoLo := na
if inAS
    if na(asHi)
        f_newBox("ASIA", colAS)
    f_growBox("ASIA")
    asHi := na(asHi) ? high : math.max(asHi, high)
    asLo := na(asLo) ? low : math.min(asLo, low)
    cAsHi := na(cAsHi) ? smtHigh : math.max(cAsHi, smtHigh)
    cAsLo := na(cAsLo) ? smtLow  : math.min(cAsLo, smtLow)
else if not na(asHi)
    f_newLevel("ASH", 1, asHi, colAS, cAsHi)
    f_newLevel("ASL", -1, asLo, colAS, cAsLo)
    asHi := na
    asLo := na
    cAsHi := na
    cAsLo := na

// ── Live FVGs with fill-death lifecycle ────────────────────────────
var array<float> fvgTop = array.new_float()
var array<float> fvgBot = array.new_float()
var array<int>   fvgIdx = array.new_int()
var array<int>   fvgDir = array.new_int()      // 1 bull, -1 bear
var array<box>   fvgBoxA = array.new<box>()
var array<int>   fvgInvAt = array.new_int()    // -1 = live; else bar of inversion

f_addFvg(int d, float top, float bot) =>
    fvgTop.push(top)
    fvgBot.push(bot)
    fvgIdx.push(bar_index)
    fvgDir.push(d)
    fvgInvAt.push(-1)
    color cc = d == 1 ? colBull : colBear
    fvgBoxA.push(showFvg ? box.new(bar_index - 1, top, bar_index + fvgExtBars, bot,
         border_color=color.new(cc, 100), bgcolor=color.new(cc, 92)) : box(na))
    if fvgTop.size() > 150
        box.delete(fvgBoxA.get(0))
        fvgTop.shift()
        fvgBot.shift()
        fvgIdx.shift()
        fvgDir.shift()
        fvgInvAt.shift()
        fvgBoxA.shift()

if useIfvg
    if low > high[2] and low - high[2] >= minFvgPts
        f_addFvg(1, low, high[2])
    if high < low[2] and low[2] - high >= minFvgPts
        f_addFvg(-1, low[2], high)

// ── Higher-timeframe FVGs (location confluence, group 04b) ─────────
// Same 3-bar gap rule as the 1m gaps, requested on the selected timeframe
// with lookahead_off so a gap only exists once its HTF bar has confirmed.
var array<float> hzTop = array.new_float()
var array<float> hzBot = array.new_float()
var array<int>   hzDir = array.new_int()
var array<box>   hzBox = array.new<box>()
var int lastHzTime = 0

f_htfGap() =>
    bool gb = low > high[2] and low - high[2] >= minFvgPts
    bool gs = high < low[2] and low[2] - high >= minFvgPts
    [gb, gs, gb ? low : gs ? low[2] : na, gb ? high[2] : gs ? high : na, time]

// when the overlay is off, request the chart TF instead - near-free, and
// the htfFvgShow guard below already discards the values
[hgB, hgS, hgT, hgBm, hgTime] = request.security(syminfo.tickerid, (htfFvgOn or htfFvgShow) ? htfFvgTf : timeframe.period, f_htfGap(), lookahead=barmerge.lookahead_off)

if (htfFvgOn or htfFvgShow) and (hgB or hgS) and not na(hgT) and not na(hgBm) and hgTime != lastHzTime
    lastHzTime := hgTime
    hzTop.push(hgT)
    hzBot.push(hgBm)
    hzDir.push(hgB ? 1 : -1)
    hzBox.push(htfFvgShow ? box.new(bar_index, hgT, bar_index + 1, hgBm, xloc=xloc.bar_index,
         border_color=color.new(colHtfFvg, math.max(htfTransp - 13, 0)), bgcolor=color.new(colHtfFvg, htfTransp),
         text=(htfFvgTf == "240" ? "4h" : htfFvgTf == "D" ? "1D" : htfFvgTf + "m") + " FVG", text_color=color.new(colHtfFvg, math.max(htfTransp - 48, 0)), text_size=size.tiny) : box(na))
    if hzTop.size() > 60
        box.delete(hzBox.get(0))
        hzTop.shift()
        hzBot.shift()
        hzDir.shift()
        hzBox.shift()

// gap death: a chart-bar body close beyond the far edge (same rule as 1m)
if hzTop.size() > 0
    for j = hzTop.size() - 1 to 0
        bool deadH = hzDir.get(j) == 1 ? close < hzBot.get(j) : close > hzTop.get(j)
        if deadH
            box.delete(hzBox.get(j))
            hzTop.remove(j)
            hzBot.remove(j)
            hzDir.remove(j)
            hzBox.remove(j)
        else if htfFvgShow and not na(hzBox.get(j))
            box.set_right(hzBox.get(j), bar_index + 1)

// does this bar trade inside a live higher-TF gap? (confluence filter)
f_inHtfZone() =>
    bool found = false
    if hzTop.size() > 0
        for j = 0 to hzTop.size() - 1
            if low <= hzTop.get(j) and high >= hzBot.get(j)
                found := true
                break
    found
bool inHtfGap = f_inHtfZone()

// ── Arms ───────────────────────────────────────────────────────────
var array<int>   armDir = array.new_int()
var array<float> armLvl = array.new_float()
var array<float> armExt = array.new_float()
var array<int>   armExp = array.new_int()
var array<int>   armI0  = array.new_int()
var array<bool>  armQ   = array.new<bool>()

// ── EQH/EQL module (adapted from "Equal Highs and Lows with Relative
// [CantoLab]" - same swing/equal/sweep semantics, bar_time drawings) ──
type BarRows
    array<int>   keys
    array<float> vols

type SwingPoint
    float price      = na
    int   time       = na
    int   formBarIdx = na
    bool  referenced = false

type ActiveLine
    line  ln         = na
    label lb         = na
    int   startTime  = na
    float startPrice = na
    int   endTime    = na
    float endPrice   = na

method isFarEnough(SwingPoint sp, int currentBarIdx, int minGap) =>
    (currentBarIdx - sp.formBarIdx) > minGap

method checkLevel(SwingPoint sp, float level, float tolerance, bool isHigh, int currentBarIdx, int minGap) =>
    string state = "none"
    if not sp.referenced
        bool farEnough = sp.isFarEnough(currentBarIdx, minGap)
        if isHigh
            if level > sp.price + tolerance
                state := "break"
            else if farEnough and level <= sp.price + tolerance and level >= sp.price - tolerance
                state := "equal"
        else
            if level < sp.price - tolerance
                state := "break"
            else if farEnough and level >= sp.price - tolerance and level <= sp.price + tolerance
                state := "equal"
        if state != "none"
            sp.referenced := true
    state

method mergeOrCreate(ActiveLine[] arr, SwingPoint sp, int endTime, float endPrice, float tolerance, bool isHigh) =>
    int matchIdx = -1
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            ActiveLine alx = arr.get(i)
            if alx.endTime == sp.time and math.abs(alx.endPrice - sp.price) <= tolerance
                matchIdx := i
                break
    if matchIdx == -1
        ActiveLine alNew = ActiveLine.new()
        alNew.ln := line.new(sp.time, sp.price, endTime, endPrice, xloc=xloc.bar_time, color=colEq, width=1)
        alNew.startTime := sp.time
        alNew.startPrice := sp.price
        arr.push(alNew)
        matchIdx := arr.size() - 1
    ActiveLine al = arr.get(matchIdx)
    al.endTime := endTime
    al.endPrice := endPrice
    line.set_x2(al.ln, endTime)
    line.set_y2(al.ln, endPrice)
    bool exact = al.startPrice == endPrice
    string labelText = isHigh ? (exact ? "EQH" : "REH") : (exact ? "EQL" : "REL")
    int midTime = int(math.round((al.startTime + endTime) / 2))
    if na(al.lb)
        al.lb := label.new(midTime, endPrice, labelText, xloc=xloc.bar_time,
             style=isHigh ? label.style_label_down : label.style_label_up,
             color=color.new(color.white, 100), textcolor=colEq, size=size.small)
    if not na(al.lb)
        al.lb.set_x(midTime)
        al.lb.set_y(endPrice)
        al.lb.set_text(labelText)

// last EXTERNAL sweep, meaning a session level, used by the sequencing rule
var int extBar = -99999
var int extDir = 0

// checkSweep tests the PREVIOUS bar's extreme, so its marker sits on that bar
int eqSweepT = time[1]
method checkSweep(ActiveLine[] arr, float level, bool isHigh, float tolerance) =>
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            ActiveLine al = arr.get(i)
            float extreme = isHigh ? math.max(al.startPrice, al.endPrice) : math.min(al.startPrice, al.endPrice)
            bool swept = isHigh ? level > extreme + tolerance : level < extreme - tolerance
            if swept
                bool seqOk = not extFirst or (extDir == (isHigh ? -1 : 1) and bar_index - extBar <= extFirstBars)
                if eqArm and seqOk
                    if showRaidLabels
                        bool eqExact = al.startPrice == al.endPrice
                        int eqBarsApart = int((al.endTime - al.startTime) / (timeframe.in_seconds() * 1000))
                        string eqTier = not showTier ? "" : eqExact ? (eqBarsApart > 3 ? " S" : " A") : " B"
                        label.new(eqSweepT, isHigh ? level + labPad : level - labPad,
                             "SWEEP " + (isHigh ? (eqExact ? "EQH" : "REH") : (eqExact ? "EQL" : "REL")) + eqTier, xloc=xloc.bar_time,
                             style=label.style_none, textcolor=color.new(colEq, 0), size=labSz)
                    armDir.push(isHigh ? -1 : 1)
                    armLvl.push(extreme)
                    armExt.push(level)
                    armExp.push(time + retTtlMin * 60000)
                    armI0.push(bar_index)
                    armQ.push(inHtfGap)
                line.delete(al.ln)
                if not na(al.lb)
                    label.delete(al.lb)
                arr.remove(i)

var SwingPoint[] swingHighs  = array.new<SwingPoint>()
var SwingPoint[] swingLows   = array.new<SwingPoint>()
var ActiveLine[] activeHighs = array.new<ActiveLine>()
var ActiveLine[] activeLows  = array.new<ActiveLine>()

int hb3 = ta.highestbars(3)
int lb3 = ta.lowestbars(3)

if useEq
    float eqH1 = high[1]
    float eqL1 = low[1]
    int   eqT1 = time[1]
    activeHighs.checkSweep(eqH1, true, eqTolPts)
    activeLows.checkSweep(eqL1, false, eqTolPts)
    int recentEQHIdx  = -1
    int recentEQHTime = -1
    if swingHighs.size() > 0
        for i = 0 to swingHighs.size() - 1
            SwingPoint sp = swingHighs.get(i)
            if sp.checkLevel(eqH1, eqTolPts, true, bar_index, eqMinGap) == "equal" and sp.time > recentEQHTime
                recentEQHTime := sp.time
                recentEQHIdx  := i
    int recentEQLIdx  = -1
    int recentEQLTime = -1
    if swingLows.size() > 0
        for i = 0 to swingLows.size() - 1
            SwingPoint spL = swingLows.get(i)
            if spL.checkLevel(eqL1, eqTolPts, false, bar_index, eqMinGap) == "equal" and spL.time > recentEQLTime
                recentEQLTime := spL.time
                recentEQLIdx  := i
    if hb3 == -1
        swingHighs.push(SwingPoint.new(high[1], time[1], bar_index, false))
    if lb3 == -1
        swingLows.push(SwingPoint.new(low[1], time[1], bar_index, false))
    if recentEQHIdx != -1
        activeHighs.mergeOrCreate(swingHighs.get(recentEQHIdx), eqT1, eqH1, eqTolPts, true)
    if recentEQLIdx != -1
        activeLows.mergeOrCreate(swingLows.get(recentEQLIdx), eqT1, eqL1, eqTolPts, false)
    // prune consumed swing points (behavior-neutral: checkLevel skips
    // referenced ones anyway) and cap active EQ lines so the arrays
    // and drawing count stay bounded on long histories
    if swingHighs.size() > 0
        for i = swingHighs.size() - 1 to 0
            if swingHighs.get(i).referenced
                swingHighs.remove(i)
    if swingLows.size() > 0
        for i = swingLows.size() - 1 to 0
            if swingLows.get(i).referenced
                swingLows.remove(i)
    if activeHighs.size() > 100
        ActiveLine oldEqH = activeHighs.get(0)
        line.delete(oldEqH.ln)
        label.delete(oldEqH.lb)
        activeHighs.remove(0)
    if activeLows.size() > 100
        ActiveLine oldEqL = activeLows.get(0)
        line.delete(oldEqL.ln)
        label.delete(oldEqL.lb)
        activeLows.remove(0)

// ── Order-flow absorption on the sweep bar (footprint) ───────────────
// request.footprint() reads the CURRENT chart bar only, so every reading
// below belongs to the bar being processed. It returns na wherever
// footprint data is unavailable (plan, symbol, or history depth), and
// every downstream test fails open rather than silently dropping signals.

fpBar = absOn or vpOn or cvdOn ? request.footprint(absTicksRow, absVaPct, absImbPct) : na
bool fpOk = not na(fpBar)
float fpDelta = fpOk ? footprint.delta(fpBar) : na

// Verdict plus raw readings for a sweep on one side. isHigh=true means price
// swept UP through a high, so the reversal being armed is a short. Kept as a
// single function: the row scan and the verdict share the same locals, which
// avoids returning a tuple into another function's scope.
var int lvLastBar = -1   // bar the last sweep marker was drawn on
var int lvStack   = 0    // markers already drawn on that bar

// ── Export slots + counters ─────────────────────────────────────────
// The sweep readings are produced deep inside the level loop. These
// bar-scoped variables lift them to the top level so they can be plotted
// into the Data Window, which is what TradingView's "Export chart data"
// writes to CSV. Everything here is measurement, never logic.

float xSweepDir = na    // -1 = a high was swept (short arm), +1 = a low
float xSmt = na         // -1 = bearish SMT at a high sweep, +1 = bullish at a low
var int cSmtEval = 0    // sweeps where the comparison could be made
var int cSmt     = 0    // of those, sweeps that carried SMT
float xSmtEs = na       // comparison market swept its extreme alone: -1 bear, +1 bull
var int cSmtEs   = 0
float xSweepLvl = na

var int cRaid  = 0     // sweeps on an arming session, filter aside
var int cArm   = 0
var int cSigL  = 0
var int cSigS  = 0

if lvLine.size() > 0
    for j = lvLine.size() - 1 to 0
        if not lvLive.get(j)
            continue
        line ln = lvLine.get(j)
        float price = lvPx.get(j)
        if not na(ln)
            ln.set_x2(time)
        bool isHigh = lvSide.get(j) == 1
        // running non-confirmation state: once the comparison market exceeds its
        // own session extreme on ANY bar while the level is live, divergence is
        // off the table for this level. Checked before the touch so a same-bar
        // confirmation also counts.
        float cmpLvl = lvCmp.get(j)
        bool cmpBroke = false
        if smtOn and not na(cmpLvl) and not lvCmpBrk.get(j)
            if isHigh ? smtHigh > cmpLvl : smtLow < cmpLvl
                lvCmpBrk.set(j, true)
                cmpBroke := true
        bool touched = isHigh ? high >= price : low <= price
        // mirror SMT: the comparison market took its extreme on this bar and this
        // chart's level is still untouched. One mark per level, since the flag
        // above only flips once.
        if smtEsSide and cmpBroke and not touched
            cSmtEs += 1
            xSmtEs := isHigh ? -1 : 1
            if not dMin
                float esY = isHigh ? high + labPad : low - labPad
                if bar_index != lvLastBar
                    lvLastBar := bar_index
                    lvStack   := 0
                esY := isHigh ? esY + labPad * 1.4 * lvStack : esY - labPad * 1.4 * lvStack
                lvStack += 1
                label.new(time, esY, (isHigh ? "bear SMT: " : "bull SMT: ") + smtShort + " took " + lvTag.get(j), xloc=xloc.bar_time,
                     style=isHigh ? label.style_label_down : label.style_label_up,
                     color=color.new(isHigh ? colSmtDn : colSmtUp, 15), textcolor=color.white, size=labSz)
        if touched
            lvLive.set(j, false)
            bool raided = isHigh ? high >= price + sweepBufPts : low <= price - sweepBufPts
            string tg0 = lvTag.get(j)
            // a pool from an earlier day carries its date, so a month-old level reads as one
            int tMade0 = lvT.get(j)
            string age0 = time - tMade0 > 86400000 ? " " + str.format_time(tMade0, "MM-dd", tzNY) : ""
            bool armOk0 = str.startswith(tg0, "NY") ? armNY : str.startswith(tg0, "LO") ? armLO : armAS
            // the correlated market failed to take out its own matching extreme
            // taught version: did the comparison market take out ITS OWN extreme
            // from the same session at ANY point since it froze? Rolling is the
            // cruder fixed-window variant.
            bool smtDiv = false
            if smtOn and raided
                if smtRef == "Session extreme" and not na(cmpLvl)
                    smtDiv := not lvCmpBrk.get(j)
                else if smtRef == "Rolling bars"
                    smtDiv := isHigh ? smtHigh <= cmpPriorHigh : smtLow >= cmpPriorLow
            if showRaidLabels
                // float the marker clear of the wick instead of sitting on the level:
                // highs anchor above the bar's high, lows below its low, +/- labPad
                float lvY = isHigh ? math.max(high, price) + labPad : math.min(low, price) - labPad
                // several levels can be swept by one bar; step each marker
                // further out so they stack instead of printing on top of each other
                if bar_index != lvLastBar
                    lvLastBar := bar_index
                    lvStack   := 0
                lvY := isHigh ? lvY + labPad * 1.4 * lvStack : lvY - labPad * 1.4 * lvStack
                lvStack += 1
                color lvCol = str.startswith(tg0, "NY") ? colNY : str.startswith(tg0, "LO") ? colLO : colAS
                if raided
                    label.new(time, lvY, (armOk0 ? "SWEEP " : "swept ") + tg0 + age0 + (showTier ? " B" : "") + (smtDiv and not smtMark ? "  SMT" : ""), xloc=xloc.bar_time,
                         style=dFull ? (isHigh ? label.style_label_down : label.style_label_up) : label.style_none,
                         color=color.new(lvCol, armOk0 ? 25 : 60),
                         textcolor=dFull ? color.white : color.new(lvCol, 0), size=labSz)
                else if dFull
                    // shallow touch: quiet text-only marker, no bubble
                    label.new(time, lvY, "hit " + tg0, xloc=xloc.bar_time,
                         style=label.style_none, textcolor=color.new(color.gray, 35), size=labSz)
            if smtOn and raided and (smtRef == "Rolling bars" or not na(cmpLvl))
                cSmtEval += 1
                if smtDiv
                    cSmt += 1
                    xSmt := isHigh ? -1 : 1
            if smtMark and smtDiv
                // same stacking as the sweep markers, one slot further out
                float smY = isHigh ? math.max(high, price) + labPad : math.min(low, price) - labPad
                if bar_index != lvLastBar
                    lvLastBar := bar_index
                    lvStack   := 0
                smY := isHigh ? smY + labPad * 1.4 * lvStack : smY - labPad * 1.4 * lvStack
                lvStack += 1
                label.new(time, smY, (isHigh ? "bear SMT vs " : "bull SMT vs ") + smtShort, xloc=xloc.bar_time,
                     style=isHigh ? label.style_label_down : label.style_label_up,
                     color=color.new(isHigh ? colSmtDn : colSmtUp, 15), textcolor=color.white, size=labSz)
            if raided and armOk0
                extBar := bar_index
                extDir := isHigh ? -1 : 1
                cRaid += 1
                cArm += 1
                xSweepDir := isHigh ? -1 : 1
                xSweepLvl := price
            if raided and armOk0
                armDir.push(isHigh ? -1 : 1)
                armLvl.push(price)
                armExt.push(isHigh ? high : low)
                armExp.push(time + retTtlMin * 60000)
                armI0.push(bar_index)
                armQ.push(inHtfGap)

// ── Trigger scan + FVG lifecycle ───────────────────────────────────
// Expiry pass first, then ONE inversion scan per direction. A single
// body-closed gap clears EVERY live arm of that direction: one signal
// per reversal context. (A per-arm scan that consumes one gap per arm
// fires late duplicate signals when sweeps stack.)
// Stacked gaps (2026-09-19 frame audit): starting from the gap the close
// just went through, walk older same-side gaps of the same leg. A gap
// whose near edge sits within stackTolPts of the running far edge is
// stacked on it, and the close has to be beyond that one too.
f_stackOk(int k, int d, int minIdx) =>
    bool ok = true
    float edge = d == -1 ? fvgBot.get(k) : fvgTop.get(k)
    if stackReq and k > 0
        for m = k - 1 to 0
            if fvgIdx.get(m) < minIdx
                break
            if fvgInvAt.get(m) != -1 or fvgDir.get(m) != -d
                continue
            if d == -1
                if edge - fvgTop.get(m) <= stackTolPts and fvgBot.get(m) < edge
                    if close < fvgBot.get(m)
                        edge := fvgBot.get(m)
                    else
                        ok := false
                        break
            else
                if fvgBot.get(m) - edge <= stackTolPts and fvgTop.get(m) > edge
                    if close > fvgTop.get(m)
                        edge := fvgTop.get(m)
                    else
                        ok := false
                        break
    ok

f_fireDir(int d) =>
    // newest same-direction armI0 anchors the pre-sweep lookback window
    int newestI0 = -1
    if armDir.size() > 0
        for j = 0 to armDir.size() - 1
            if armDir.get(j) == d
                newestI0 := math.max(newestI0, armI0.get(j))
    bool qOk = not htfFvgOn
    if not qOk and armDir.size() > 0
        for j = 0 to armDir.size() - 1
            if armDir.get(j) == d and armQ.get(j)
                qOk := true
                break
    int hitK = -1
    if newestI0 >= 0 and qOk
        if useIfvg
            if fvgTop.size() > 0
                for k = fvgTop.size() - 1 to 0
                    if fvgInvAt.get(k) != -1
                        continue
                    if fvgIdx.get(k) < newestI0 - fvgLookback
                        break
                    if d == -1 and fvgDir.get(k) == 1 and close < fvgBot.get(k)
                        hitK := f_stackOk(k, d, newestI0 - fvgLookback) ? k : -1
                        break
                    if d == 1 and fvgDir.get(k) == -1 and close > fvgTop.get(k)
                        hitK := f_stackOk(k, d, newestI0 - fvgLookback) ? k : -1
                        break
        else
            for j = 0 to armDir.size() - 1
                if armDir.get(j) == d and (d == -1 ? close < armLvl.get(j) : close > armLvl.get(j))
                    hitK := -2
                    break
    hitK

f_dropDir(int d) =>
    if armDir.size() > 0
        for j = armDir.size() - 1 to 0
            if armDir.get(j) == d
                armDir.remove(j)
                armLvl.remove(j)
                armExt.remove(j)
                armExp.remove(j)
                armI0.remove(j)
                armQ.remove(j)

bool sigLong  = false
bool sigShort = false
if armDir.size() > 0
    for j = armDir.size() - 1 to 0
        if time > armExp.get(j)
            armDir.remove(j)
            armLvl.remove(j)
            armExt.remove(j)
            armExp.remove(j)
            armI0.remove(j)
            armQ.remove(j)
        else
            armExt.set(j, armDir.get(j) == -1 ? math.max(armExt.get(j), high) : math.min(armExt.get(j), low))

if htfFvgOn and inHtfGap and armDir.size() > 0
    for j = 0 to armDir.size() - 1
        armQ.set(j, true)

for s = 0 to 1
    int d = s == 0 ? -1 : 1
    int hitK = f_fireDir(d)
    if hitK != -1
        if hitK >= 0
            fvgInvAt.set(hitK, bar_index)
            box b = fvgBoxA.get(hitK)
            if not na(b)
                b.set_border_color(color.new(d == -1 ? colBear : colBull, 40))
                b.set_bgcolor(color.new(d == -1 ? colBear : colBull, 82))
                b.set_right(bar_index + invExtBars)
        // signal label floats 2x pad beyond the bar (clears both the wick and
        // the entry triangle); the triangle stays the precise entry marker
        float sigY = d == -1 ? high + labPad * 2 : low - labPad * 2
        color sigCol = d == -1 ? colBear : colBull
        // the triangle on the bar is the precise entry mark, so the word next
        // to it only has to be readable, not boxed
        string sigTxt = (d == -1 ? "SHORT" : "LONG") + (inWin ? "" : dFull ? "  outside window" : "")
        bool badge = sigStyle == "Badge"
        label.new(time, sigY, sigTxt, xloc=xloc.bar_time,
             style=badge ? (d == -1 ? label.style_label_down : label.style_label_up) : label.style_none,
             color=color.new(sigCol, badge ? 35 : 100),
             textcolor=badge ? color.white : color.new(sigCol, inWin ? 0 : 45), size=labSz)
        f_dropDir(d)
        if inWin
            if d == 1
                sigLong := true
                cSigL += 1
            else
                sigShort := true
                cSigS += 1

// one wide bar can trigger BOTH directions when opposite sweeps are still
// armed; keeping the flags separate means neither plotshape, alert nor the
// export drops one. Export encoding: +1 long, -1 short, 2 both.
int plotTrig = sigLong and sigShort ? 2 : sigLong ? 1 : sigShort ? -1 : 0

// filled gaps die: delete box + remove from logic (inversion above already ran)
if fvgTop.size() > 0
    for k = fvgTop.size() - 1 to 0
        int inv = fvgInvAt.get(k)
        bool dead = false
        if inv != -1
            dead := bar_index > inv + invExtBars
        else
            if fvgIdx.get(k) < bar_index
                if fvgDir.get(k) == 1
                    dead := bodyFill ? close < fvgBot.get(k) : low < fvgBot.get(k)
                else
                    dead := bodyFill ? close > fvgTop.get(k) : high > fvgTop.get(k)
                if not dead and na(fvgBoxA.get(k)) == false and bar_index <= fvgIdx.get(k) + fvgExtBars
                    box b2 = fvgBoxA.get(k)
                    b2.set_right(bar_index + 1)
        if dead
            box.delete(fvgBoxA.get(k))
            fvgTop.remove(k)
            fvgBot.remove(k)
            fvgIdx.remove(k)
            fvgDir.remove(k)
            fvgInvAt.remove(k)
            fvgBoxA.remove(k)

plotshape(sigShort, "Signal short (enter next bar)", shape.triangledown, location.abovebar, color.red, size=size.small, display=display.pane)
plotshape(sigLong, "Signal long (enter next bar)", shape.triangleup, location.belowbar, color.green, size=size.small, display=display.pane)
bgcolor(armDir.size() > 0 ? color.new(color.yellow, 92) : na, title="Armed (level swept, waiting for trigger)")

// ── Trade levels: entry / stop / target (group 16) ───────────────────
// The trade each signal implies, drawn the way the VLS indicator draws
// it: entry, a stop behind the swing the sweep ran, and a target tlRR
// times that risk away. Display only - no branch below writes sigLong,
// sigShort or any counter, so a setup the risk filter skips still fires
// its triangle and its alert.
//
// The stop anchor. A fractal confirms tlPivN bars AFTER its swing bar,
// so the last confirmed swing on its own can sit above the wick that
// triggered the entry. The running extreme fixes that: it restarts at
// each confirmed swing and then tracks the lowest low (highest high)
// printed since, so it IS the swing until price trades through it and
// the sweep wick once it does.

float tlPvLo = ta.pivotlow(tlPivN, tlPivN)
float tlPvHi = ta.pivothigh(tlPivN, tlPivN)
var float tlSwLo  = na   // last confirmed swing low  (the structural stop)
var float tlSwHi  = na
var float tlRunLo = na   // lowest low printed since that swing confirmed
var float tlRunHi = na
if not na(tlPvLo)
    tlSwLo  := tlPvLo
    tlRunLo := tlPvLo
if not na(tlPvHi)
    tlSwHi  := tlPvHi
    tlRunHi := tlPvHi
tlRunLo := na(tlRunLo) ? low  : math.min(tlRunLo, low)
tlRunHi := na(tlRunHi) ? high : math.max(tlRunHi, high)

var array<line>  tlLn = array.new<line>()
var array<label> tlLb = array.new<label>()
var array<box>   tlBx = array.new<box>()

// oldest setups go first: the 500-drawing cap is shared with the level
// lines, gap boxes and sweep markers, which must not be starved.
f_tlCull() =>
    while tlLn.size() > tlKeep * 3
        line.delete(tlLn.shift())
    while tlBx.size() > tlKeep * 2
        box.delete(tlBx.shift())
    while tlLb.size() > tlKeep
        label.delete(tlLb.shift())
    true

// a setup is drawable when the stop is a real distance away and, when
// the risk cap is on, inside it
f_tlOk(float entry, float sl) =>
    float r = math.abs(entry - sl)
    r > tick / 2 and (tlMaxPts <= 0 or r <= tlMaxPts)

// returns the target price so the caller can export it
f_tlDraw(int d, float entry, float sl, int x0, bool atSwing) =>
    float risk = math.abs(entry - sl)
    float tp   = d == 1 ? entry + tlRR * risk : entry - tlRR * risk
    int   x1   = x0 + tlBars
    if tlZones
        tlBx.push(box.new(x0, math.max(entry, sl), x1, math.min(entry, sl),
             border_color=color.new(colBear, 60), bgcolor=color.new(colBear, 88)))
        tlBx.push(box.new(x0, math.max(entry, tp), x1, math.min(entry, tp),
             border_color=color.new(colBull, 60), bgcolor=color.new(colBull, 88)))
    tlLn.push(line.new(x0, entry, x1, entry, color=color.new(color.gray, 15), style=line.style_dotted))
    tlLn.push(line.new(x0, sl,    x1, sl,    color=color.new(colBear, 0),     style=line.style_solid))
    tlLn.push(line.new(x0, tp,    x1, tp,    color=color.new(colBull, 0),     style=line.style_solid))
    if tlLabel
        color tlCol = d == 1 ? colBull : colBear
        string tlTxt = (d == 1 ? "LONG" : "SHORT")
             + "  E " + str.tostring(entry, format.mintick)
             + "   SL " + str.tostring(sl, format.mintick) + (atSwing ? " (swing)" : " (wick)")
             + "   TP " + str.tostring(tp, format.mintick) + "  " + str.tostring(tlRR, "#.##") + "R"
             + "   risk " + str.tostring(risk, format.mintick)
        tlLb.push(label.new(x1, tp, tlTxt, style=label.style_label_left,
             color=color.new(tlCol, 78), textcolor=color.new(tlCol, 0), size=labSz))
    f_tlCull()
    tp

// pending setup, held from the signal bar to the bar whose open fills it
var int   tlPBar = na
var float tlPLSl = na    // pending long stop  (na = no pending long)
var float tlPSSl = na    // pending short stop
var bool  tlPLSw = false // that stop sat on the swing, not the sweep wick
var bool  tlPSSw = false

// one row per drawn setup, for the CSV test bench
float tlXEntry = na
float tlXStop  = na
float tlXTgt   = na
float tlXRisk  = na
float tlXDir   = na

bool  tlNext = tlEntry == "Next bar open"
float tlBufP = tlBuf * tick

// Drawing the pending setup runs BEFORE capturing a new one: a signal on
// the very next bar would otherwise overwrite the pending slot and the
// first setup would never be drawn.
if tlOn and tlNext and not na(tlPBar) and bar_index == tlPBar + 1
    if not na(tlPLSl)
        float eL = open
        float sL = math.min(tlPLSl, eL - tick)   // a long stop must sit below the fill
        if f_tlOk(eL, sL)
            tlXTgt   := f_tlDraw(1, eL, sL, tlPBar, tlPLSw)
            tlXEntry := eL
            tlXStop  := sL
            tlXRisk  := eL - sL
            tlXDir   := 1.0
    if not na(tlPSSl)
        float eS = open
        float sS = math.max(tlPSSl, eS + tick)
        if f_tlOk(eS, sS)
            tlXTgt   := f_tlDraw(-1, eS, sS, tlPBar, tlPSSw)
            tlXEntry := eS
            tlXStop  := sS
            tlXRisk  := sS - eS
            tlXDir   := -1.0
    tlPBar := na
    tlPLSl := na
    tlPSSl := na

if tlOn and (sigLong or sigShort)
    float tlSlL = (tlSlSrc == "Signal bar wick" ? low  : nz(tlRunLo, low))  - tlBufP
    float tlSlS = (tlSlSrc == "Signal bar wick" ? high : nz(tlRunHi, high)) + tlBufP
    // still resting on the swing itself, or already pushed down to the wick
    bool tlSwgL = tlSlSrc != "Signal bar wick" and not na(tlSwLo) and tlRunLo >= tlSwLo - tick / 2
    bool tlSwgS = tlSlSrc != "Signal bar wick" and not na(tlSwHi) and tlRunHi <= tlSwHi + tick / 2
    if tlNext
        tlPBar := bar_index
        tlPLSl := sigLong  ? tlSlL : na
        tlPSSl := sigShort ? tlSlS : na
        tlPLSw := tlSwgL
        tlPSSw := tlSwgS
    else
        if sigLong
            float cL = close
            float kL = math.min(tlSlL, cL - tick)
            if f_tlOk(cL, kL)
                tlXTgt   := f_tlDraw(1, cL, kL, bar_index, tlSwgL)
                tlXEntry := cL
                tlXStop  := kL
                tlXRisk  := cL - kL
                tlXDir   := 1.0
        if sigShort
            float cS = close
            float kS = math.max(tlSlS, cS + tick)
            if f_tlOk(cS, kS)
                tlXTgt   := f_tlDraw(-1, cS, kS, bar_index, tlSwgS)
                tlXEntry := cS
                tlXStop  := kS
                tlXRisk  := kS - cS
                tlXDir   := -1.0

// Export. In "Next bar open" mode these print one bar AFTER the signal
// triangle, because that is the bar the fill happens on.
plot(tlXEntry, "Trade: entry",  display=display.data_window)
plot(tlXStop,  "Trade: stop",   display=display.data_window)
plot(tlXTgt,   "Trade: target", display=display.data_window)
plot(tlXRisk,  "Trade: risk (points)", display=display.data_window)
plot(tlXDir,   "Trade: direction (+1 long, -1 short)", display=display.data_window)

// ── Macro dealing range: premium/discount (merged from the standalone
// "Macro Dealing Range & Premium/Discount" indicator) ────────────────

float pdHigh = ta.highest(high, pdLookback)
float pdLow  = ta.lowest(low, pdLookback)
float pdEq   = (pdHigh + pdLow) / 2

// Boundary plots go to the Data Window only (display.data_window): the
// fills between them still render on the chart, but with no pane plots
// there are no selection dots when the indicator is clicked.
pPdHigh = plot(usePD ? pdHigh : na, "Premium Top",     color.new(colPdBear, 50), style=plot.style_linebr, display=display.data_window)
pPdEq   = plot(usePD ? pdEq   : na, "Equilibrium",     color.new(color.gray, 50), style=plot.style_linebr, display=display.data_window)
pPdLow  = plot(usePD ? pdLow  : na, "Discount Bottom", color.new(colPdBull, 50), style=plot.style_linebr, display=display.data_window)
fill(pPdHigh, pPdEq, color=colPdBear, title="Premium Zone")
fill(pPdEq, pPdLow, color=colPdBull, title="Discount Zone")

// dotted equilibrium midline as a drawing (drawings get no selection dots);
// left edge clamped to bar 0: a negative bar_index coordinate is a runtime error
var line pdEqLine = na
if usePD and barstate.islast
    line.delete(pdEqLine)
    pdEqLine := line.new(math.max(bar_index - pdLookback + 1, 0), pdEq, bar_index + 3, pdEq, color=color.new(color.gray, 45), style=line.style_dotted)

// ── Swing points (Williams fractals) ─────────────────────────────────

float swPtHi = ta.pivothigh(swingN, swingN)
float swPtLo = ta.pivotlow(swingN, swingN)
plotshape(useSwings and not na(swPtHi), "Swing high", shape.triangleup,   location.abovebar, colSwHi, offset=-swingN, size=size.tiny, display=display.pane)
plotshape(useSwings and not na(swPtLo), "Swing low",  shape.triangledown, location.belowbar, colSwLo, offset=-swingN, size=size.tiny, display=display.pane)

// ── Internal SMT at swing points (group 11) ─────────────────────────
// Judged at the swing marks above. The comparison market's value for a
// swing is its extreme over the same 2N+1 bars the fractal spans, so a
// swing that lands one bar apart on the two markets still lines up.
float esWinHi = ta.highest(smtHigh, 2 * swingN + 1)
float esWinLo = ta.lowest(smtLow, 2 * swingN + 1)
var float isPrevPh = na
var float isPrevEh = na
var int   isPrevHb = na
var float isPrevPl = na
var float isPrevEl = na
var int   isPrevLb = na
var array<line>  isLines = array.new<line>()
var array<label> isLabs  = array.new<label>()
var int cSmtInt = 0
float xSmtInt = na    // -1 bear at a swing high, +1 bull at a swing low, 2 both

f_isDraw(int b0, float y0, int b1, float y1, bool bear) =>
    color c = bear ? colSmtDn : colSmtUp
    isLines.push(line.new(b0, y0, b1, y1, color=color.new(c, 10), style=line.style_dotted, width=2))
    isLabs.push(label.new(b1, bear ? y1 + labPad : y1 - labPad, bear ? "bear SMT" : "bull SMT", style=label.style_none, textcolor=color.new(c, 0), size=size.small))
    while isLines.size() > smtIntKeep
        line.delete(isLines.shift())
        label.delete(isLabs.shift())

if smtOn and smtInt and not na(swPtHi)
    int bH = bar_index - swingN
    if not na(isPrevPh) and not na(isPrevEh) and not na(esWinHi)
        if (swPtHi > isPrevPh) != (esWinHi > isPrevEh)
            cSmtInt += 1
            xSmtInt := -1
            if not dMin
                f_isDraw(isPrevHb, isPrevPh, bH, swPtHi, true)
    isPrevPh := swPtHi
    isPrevEh := esWinHi
    isPrevHb := bH

if smtOn and smtInt and not na(swPtLo)
    int bL = bar_index - swingN
    if not na(isPrevPl) and not na(isPrevEl) and not na(esWinLo)
        if (swPtLo < isPrevPl) != (esWinLo < isPrevEl)
            cSmtInt += 1
            xSmtInt := na(xSmtInt) ? 1 : 2
            if not dMin
                f_isDraw(isPrevLb, isPrevPl, bL, swPtLo, false)
    isPrevPl := swPtLo
    isPrevEl := esWinLo
    isPrevLb := bL

plot(xSmtEs,  "SMT: comparison swept alone (-1 bear, +1 bull)", display=display.data_window)
plot(xSmtInt, "SMT: at swing points (-1 bear, +1 bull, 2 both)", display=display.data_window)
alertcondition(not na(xSmtEs), "SMT: comparison market swept alone", "LiqSweep+iFVG: SMT, the comparison market took a session level this chart did not, on {{ticker}} {{interval}} at {{close}}")
alertcondition(not na(xSmtInt), "SMT at swing points", "LiqSweep+iFVG: SMT divergence at a swing point on {{ticker}} {{interval}} at {{close}}")


// ── Measurement export + sample-size panel ──────────────────────────
// These plots carry one value per sweep bar and na everywhere else. They
// render nowhere on the chart (display.data_window), but TradingView's
// "Export chart data" writes every plot to the CSV, which is how the sweep
// readings get out of Pine and into a threshold sweep.

plot(xSweepDir, "OF: sweep direction (-1 high, +1 low)", display=display.data_window)
plot(xSweepLvl, "OF: swept level",                     display=display.data_window)
plot(xSmt,      "SMT at the sweep (-1 bear, +1 bull)", display=display.data_window)
plot(fpDelta,  "OF: bar delta",                        display=display.data_window)
plot(plotTrig == 0 ? na : plotTrig + 0.0, "Signal (-1 short, +1 long, 2 both)", display=display.data_window)




// Both footprint accumulators are rolling windows anchored to the last bar,
// so bars older than the longest window can never affect what is drawn.
// Skipping them is what keeps the script from walking 20,000 bars of rows.
bool inCalcWin = bar_index > last_bar_index - math.max(vpBars, 400) - 10

// ── Volume profile from footprint rows ──────────────────────────────
// request.footprint() only reads the current bar, so a profile spanning
// many bars has to be accumulated as the script walks forward. Each bar's
// rows are bucketed onto a fixed price grid and added to a running map;
// in Rolling scope the bar leaving the window is subtracted again, which
// keeps the work per bar proportional to one bar's row count instead of
// the whole window.

float vpStep = absTicksRow * syminfo.mintick

var map<int, float>   vpMap = map.new<int, float>()
var array<BarRows>    vpQ   = array.new<BarRows>()
var array<line>       vpOld = array.new<line>()

float vpDayChg = ta.change(time("D"))
bool vpNewDay = vpScope == "Day" and vpDayChg != 0
// fixed-window scope: accumulate only inside the clock window, then freeze
bool vpInWin    = not na(time(timeframe.period, vpWin, tzNY))
bool vpWinOpen  = vpScope == "Fixed window" and vpInWin and not vpInWin[1]
bool vpWinClose = vpScope == "Fixed window" and not vpInWin and vpInWin[1]

// point of control and value-area edges of the current map, in price
f_vpLevels(bool active) =>
    float poc = na
    float vah = na
    float val = na
    array<int> ks = active ? vpMap.keys() : array.new_int()
    if ks.size() > 0
        float tot  = 0.0
        float pocV = -1.0
        int   pocK = 0
        int   minK = ks.get(0)
        int   maxK = ks.get(0)
        for k in ks
            float v = vpMap.get(k)
            tot += v
            if v > pocV
                pocV := v
                pocK := k
            minK := math.min(minK, k)
            maxK := math.max(maxK, k)
        float target = tot * vpVaPct / 100.0
        float acc = pocV
        int lo = pocK
        int hi = pocK
        // expand outward one grid step at a time, taking the heavier side
        while acc < target and (lo > minK or hi < maxK)
            float vd = lo > minK and vpMap.contains(lo - 1) ? vpMap.get(lo - 1) : 0.0
            float vu = hi < maxK and vpMap.contains(hi + 1) ? vpMap.get(hi + 1) : 0.0
            if hi < maxK and (vu >= vd or lo <= minK)
                hi += 1
                acc += vu
            else
                lo -= 1
                acc += vd
        poc := pocK * vpStep
        vah := hi * vpStep
        val := lo * vpStep
    [poc, vah, val]

// One scan per bar at most, and only on bars that actually draw: the key
// loop is proportional to the whole profile, unlike the accumulation above.
[cPoc, cVah, cVal] = f_vpLevels(vpOn and (vpNewDay or vpWinClose or barstate.islast))

// the frozen edges of the last completed fixed window
var float wPoc = na
var float wVah = na
var float wVal = na
if vpOn and vpWinClose
    wPoc := cPoc
    wVah := cVah
    wVal := cVal
    if vpPriorDays > 0 and not na(cPoc)
        vpOld.push(line.new(bar_index, cPoc, bar_index + 1, cPoc, extend=extend.right, color=color.new(colPoc, 30), width=1))
        vpOld.push(line.new(bar_index, cVah, bar_index + 1, cVah, extend=extend.right, color=color.new(colVa, 40), style=line.style_dotted))
        vpOld.push(line.new(bar_index, cVal, bar_index + 1, cVal, extend=extend.right, color=color.new(colVa, 40), style=line.style_dotted))
    while vpOld.size() > vpPriorDays * 3
        line.delete(vpOld.shift())
if vpOn and vpWinOpen
    vpMap.clear()
    vpQ.clear()

if vpOn and fpOk and inCalcWin and (vpScope != "Fixed window" or vpInWin)
    // a finished day leaves its levels behind before the map is cleared
    if vpNewDay
        if vpPriorDays > 0 and not na(cPoc)
            vpOld.push(line.new(bar_index, cPoc, bar_index + 1, cPoc, extend=extend.right, color=color.new(colPoc, 30), width=1))
            vpOld.push(line.new(bar_index, cVah, bar_index + 1, cVah, extend=extend.right, color=color.new(colVa, 40), style=line.style_dotted))
            vpOld.push(line.new(bar_index, cVal, bar_index + 1, cVal, extend=extend.right, color=color.new(colVa, 40), style=line.style_dotted))
        while vpOld.size() > vpPriorDays * 3
            line.delete(vpOld.shift())
        vpMap.clear()
        vpQ.clear()

    BarRows br = BarRows.new(array.new_int(), array.new_float())
    array<volume_row> vrows = footprint.rows(fpBar)
    for r in vrows
        float mid = (volume_row.up_price(r) + volume_row.down_price(r)) / 2
        int   key = int(math.round(mid / vpStep))
        float v   = volume_row.total_volume(r)
        br.keys.push(key)
        br.vols.push(v)
        vpMap.put(key, (vpMap.contains(key) ? vpMap.get(key) : 0.0) + v)
    vpQ.push(br)

    if vpScope == "Rolling bars"
        while vpQ.size() > vpBars
            BarRows gone = vpQ.shift()
            for idx = 0 to gone.keys.size() - 1
                int k = gone.keys.get(idx)
                if vpMap.contains(k)
                    float nv = vpMap.get(k) - gone.vols.get(idx)
                    if nv <= 0
                        vpMap.remove(k)
                    else
                        vpMap.put(k, nv)

var line vpPocLn = na
var line vpVahLn = na
var line vpValLn = na

if vpOn and barstate.islast
    line.delete(vpPocLn)
    line.delete(vpVahLn)
    line.delete(vpValLn)
    if not na(cPoc)
        int x0 = math.max(0, bar_index - (vpScope == "Rolling bars" ? vpBars : vpQ.size()))
        vpPocLn := line.new(x0, cPoc, bar_index + 5, cPoc, color=color.new(colPoc, 15), width=1)
        vpVahLn := line.new(x0, cVah, bar_index + 5, cVah, color=color.new(colVa, 20), style=line.style_dashed)
        vpValLn := line.new(x0, cVal, bar_index + 5, cVal, color=color.new(colVa, 20), style=line.style_dashed)

// ── Sample-size panel ──────────────────────────
// Placed last: it reads counters that the modules above increment.

var table stat = table.new(position.bottom_right, 2, 5, border_width=1)
f_stat(int row, string k, string v) =>
    table.cell(stat, 0, row, k, text_color=color.white, text_size=size.small, text_halign=text.align_left,  bgcolor=color.new(color.black, 30))
    table.cell(stat, 1, row, v, text_color=color.white, text_size=size.small, text_halign=text.align_right, bgcolor=color.new(color.black, 30))

if showStats and barstate.islast
    f_stat(0, "sweeps on arming sessions", str.tostring(cRaid))
    f_stat(1, "armed",                    str.tostring(cArm))
    f_stat(2, "signals long",             str.tostring(cSigL))
    f_stat(3, "signals short",            str.tostring(cSigS))
    f_stat(4, "signals total",            str.tostring(cSigL + cSigS))

// ── Alerts ──────────────────────────────────────────────────────────
// Notification is the alternative to drawing: leave the markers off and
// let TradingView tell you, which costs the chart nothing.

alertcondition(sigLong,  "Long entry",  "LiqSweep+iFVG: LONG signal on {{ticker}} {{interval}} at {{close}}")
alertcondition(sigShort, "Short entry", "LiqSweep+iFVG: SHORT signal on {{ticker}} {{interval}} at {{close}}")
alertcondition(sigLong or sigShort, "Any entry", "LiqSweep+iFVG: entry signal on {{ticker}} {{interval}} at {{close}}")
alertcondition(not na(xSweepDir), "Level swept", "LiqSweep+iFVG: liquidity level swept on {{ticker}} {{interval}} at {{close}}")
alertcondition(not na(xSmt), "SMT at a sweep", "LiqSweep+iFVG: SMT divergence at a level sweep on {{ticker}} {{interval}} at {{close}}")

// ── Value-area reclaim (failed auction) ─────────────────────────────
// After the fixed window freezes its value area, a close beyond an edge that
// is then closed back through is a failed auction: the market probed outside
// the balance area, found nothing, and came back. Same close-back-through
// logic the sweep trigger uses, aimed at the value-area edges.

var bool vaBelow = false   // price has closed below the frozen value-area low
var bool vaAbove = false   // price has closed above the frozen value-area high
bool xVaReclaim = false    // true only on a bar that actually prints a reclaim

if vpOn and vpReclaim and vpScope == "Fixed window" and not na(wVal)
    // reset at window open AND at window close: the edges change at close,
    // and a stale flag measured against yesterday's edge would print a
    // phantom reclaim against the brand-new one.
    if vpWinOpen or vpWinClose
        vaBelow := false
        vaAbove := false
    if close < wVal
        vaBelow := true
    else if vaBelow and close > wVal
        vaBelow := false
        xVaReclaim := true
        label.new(bar_index, low - labPad, "VAL reclaim", style=label.style_none,
             textcolor=color.new(colBull, 0), size=labSz)
    if close > wVah
        vaAbove := true
    else if vaAbove and close < wVah
        vaAbove := false
        xVaReclaim := true
        label.new(bar_index, high + labPad, "VAH reclaim", style=label.style_none,
             textcolor=color.new(colBear, 0), size=labSz)

// ── CVD strip ───────────────────────────────────────────────────────
// Cumulative delta rendered inside the price pane. The raw total is
// rescaled into a band at the bottom of the visible range, so what is
// readable is its shape and its disagreement with price, not its value.

string cvdSessWin = cvdPick == "New York" ? "0930-1600" : cvdPick == "London" ? "0300-0930" : "2000-0100"
bool cvdInSess  = not na(time(timeframe.period, cvdSessWin, tzNY))
bool cvdNewDay  = ta.change(time("D")) != 0
bool cvdOpen    = cvdInSess and not cvdInSess[1]
bool cvdDoReset = cvdReset == "Day" ? cvdNewDay : cvdReset == "Session" ? cvdOpen : false

var float cvdRaw = 0.0
var int   cvdResetBar = 0
if cvdDoReset
    cvdRaw := 0.0
    cvdResetBar := bar_index
if cvdOn and fpOk
    cvdRaw += fpDelta

float cvdHi = ta.highest(cvdRaw, cvdWin)
float cvdLo = ta.lowest(cvdRaw, cvdWin)
float pxHi  = ta.highest(high, cvdWin)
float pxLo  = ta.lowest(low, cvdWin)
float band  = (pxHi - pxLo) * cvdHeight / 100.0
float cvdBase = pxLo - (pxHi - pxLo) * cvdDrop / 100.0
float cvdY  = cvdHi > cvdLo ? cvdBase + (cvdRaw - cvdLo) / (cvdHi - cvdLo) * band : na

color cvdCol = cvdRaw >= nz(cvdRaw[1]) ? colCvdUp : colCvdDn
pCvd  = plot(cvdOn ? cvdY : na, "CVD strip", color=cvdCol, linewidth=2)
pBase = plot(cvdOn ? cvdBase : na, "CVD base", color=color.new(color.gray, 100), display=display.none)
fill(pCvd, pBase, color=color.new(cvdCol, 90), title="CVD strip fill")

// divergence between confirmed price swings and the delta at those swings.
// Same pivot strength and same labels as the standalone CVD pane, so the two
// scripts agree instead of marking different bars.
float cvdPvHi = ta.pivothigh(high, cvdPivot, cvdPivot)
float cvdPvLo = ta.pivotlow(low, cvdPivot, cvdPivot)

var float cvdLastHiPx = na
var float cvdLastHiCd = na
var int   cvdLastHiBr = na
var float cvdLastHiPxY = na
var float cvdLastLoPx = na
var float cvdLastLoCd = na
var int   cvdLastLoBr = na
var float cvdLastLoPxY = na

if cvdOn and cvdDiv and not na(cvdPvHi)
    float cdAt = cvdY[cvdPivot]
    int   brAt = bar_index - cvdPivot
    bool sameRunHi = brAt >= cvdResetBar and cvdLastHiBr >= cvdResetBar
    if sameRunHi and not na(cvdLastHiPx) and cvdPvHi > cvdLastHiPx and cvdRaw[cvdPivot] < cvdLastHiCd
        float yBear = cvdDivPlace == "On the strip" ? cdAt : high[cvdPivot] + labPad * 1.5
        label.new(brAt, yBear, "bear div", xloc=xloc.bar_index, style=label.style_none,
             textcolor=color.new(colCvdDn, 0), size=labSz)
        line.new(cvdLastHiBr, cvdLastHiPxY, brAt, cdAt, color=color.new(colCvdDn, 20), width=1)
    cvdLastHiPx := cvdPvHi
    cvdLastHiCd := cvdRaw[cvdPivot]
    cvdLastHiBr := brAt
    cvdLastHiPxY := cdAt

if cvdOn and cvdDiv and not na(cvdPvLo)
    float cdAt = cvdY[cvdPivot]
    int   brAt = bar_index - cvdPivot
    bool sameRunLo = brAt >= cvdResetBar and cvdLastLoBr >= cvdResetBar
    if sameRunLo and not na(cvdLastLoPx) and cvdPvLo < cvdLastLoPx and cvdRaw[cvdPivot] > cvdLastLoCd
        float yBull = cvdDivPlace == "On the strip" ? cdAt : low[cvdPivot] - labPad * 1.5
        label.new(brAt, yBull, "bull div", xloc=xloc.bar_index, style=label.style_none,
             textcolor=color.new(colCvdUp, 0), size=labSz)
        line.new(cvdLastLoBr, cvdLastLoPxY, brAt, cdAt, color=color.new(colCvdUp, 20), width=1)
    cvdLastLoPx := cvdPvLo
    cvdLastLoCd := cvdRaw[cvdPivot]
    cvdLastLoBr := brAt
    cvdLastLoPxY := cdAt
alertcondition(xVaReclaim, "Value-area reclaim", "LiqSweep+iFVG: value-area reclaim on {{ticker}} {{interval}} at {{close}}")

// ── Prior day / week magnet levels (group 09) ───────────────────────
// Prior-period values come from COMPLETED D/W bars ([1] with lookahead_on,
// the standard non-repainting idiom), so they never move intraday. Display
// and export only: nothing here feeds the arming logic.

[pdH, pdL, pdC] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
[pwH, pwL, pwC] = request.security(syminfo.tickerid, "W", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

bool newDayBar  = ta.change(time("D")) != 0
bool newWeekBar = ta.change(time("W")) != 0

// one magnet level: line + trailing label, bright while untouched, dimmed to
// dotted with a 'hit' tag on first touch. var state is per-call-site, so each
// of the six calls below keeps its own line, label and touched flag.
f_magnet(bool on, bool renew, float px, string txt, color col) =>
    var line  ln  = na
    var label lb  = na
    var bool  hit = false
    if not on
        line.delete(ln)
        label.delete(lb)
        ln := line(na)
        lb := label(na)
    else
        if renew and not na(px)
            line.delete(ln)
            label.delete(lb)
            hit := false
            ln := line.new(bar_index, px, bar_index + 1, px, extend=extend.right, color=color.new(col, 20), width=1)
            lb := label.new(bar_index + 1, px, txt, style=label.style_none, textcolor=color.new(col, 10), size=size.small)
        if not na(lb)
            lb.set_x(bar_index + 1)
        if not na(ln) and not hit and high >= ln.get_y1() and low <= ln.get_y1()
            hit := true
            ln.set_color(color.new(col, 70))
            ln.set_style(line.style_dotted)
            lb.set_textcolor(color.new(col, 65))
            lb.set_text(txt + " hit")
    // explicit return so the if/else above is a statement, not the function's
    // return expression (its two branches end in different types)
    hit

f_magnet(pdwOn, newDayBar,  pdH, "PDH", colPdw)
f_magnet(pdwOn, newDayBar,  pdL, "PDL", colPdw)
f_magnet(pdwOn, newDayBar,  pdC, "PDC", colPdw)
f_magnet(pwkOn, newWeekBar, pwH, "PWH", colPww)
f_magnet(pwkOn, newWeekBar, pwL, "PWL", colPww)
f_magnet(pwkOn, newWeekBar, pwC, "PWC", colPww)

// ── Range spent vs typical day (group 13) ───────────────────────────
// Today's realized range against the average completed-day range: the only
// reading on the chart that says whether a reversal still has room.

float adrRef = request.security(syminfo.tickerid, "D", ta.sma(high - low, adrDays)[1], lookahead=barmerge.lookahead_on)

var float dayHi = na
var float dayLo = na
if newDayBar
    dayHi := high
    dayLo := low
else
    dayHi := math.max(nz(dayHi, high), high)
    dayLo := math.min(nz(dayLo, low), low)
float rangeSpent = adrOn and adrRef > 0 ? (dayHi - dayLo) / adrRef * 100 : na

var table adrTbl = table.new(position.top_right, 1, 1)
if adrOn and barstate.islast
    table.cell(adrTbl, 0, 0, "Range spent " + str.tostring(rangeSpent, "#") + "% of " + str.tostring(adrDays) + "d avg",
         text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 30))

// ── Status readout ──────────────────────────────────────────────────
// Says whether the two modules that can fail quietly did anything: the
// older-level scan (a higher timeframe may not reach back far enough)
// and the SMT comparison feed (a symbol with no data never diverges).
var table stTbl = table.new(position.bottom_left, 1, 2)
if showStatus and barstate.islast
    string dpTxt = not dpOn ? "Older levels: off" : not dpActive ? "Older levels: not needed on this timeframe" : "Older levels: " + str.tostring(dpCnt) + " loaded from the " + dpTf + "m scan" + (dpCnt > 0 ? ", oldest " + dpOldest : "")
    string smTxt = not smtOn ? "SMT: off" : smtFeedBars == 0 ? "SMT: NO DATA from " + smtShort : "SMT vs " + smtShort + ": " + str.tostring(cSmt) + " of " + str.tostring(cSmtEval) + " sweeps, " + str.tostring(cSmtEs) + " it swept alone, " + str.tostring(cSmtInt) + " at swings"
    table.cell(stTbl, 0, 0, dpTxt, text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(color.black, 30))
    table.cell(stTbl, 0, 1, smTxt, text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(color.black, 30))

plot(rangeSpent, "Range spent (% of typical day)", display=display.data_window)
plot(pdwOn ? pdH : na, "Prior day high",  display=display.data_window)
plot(pdwOn ? pdL : na, "Prior day low",   display=display.data_window)
plot(pwkOn ? pwH : na, "Prior week high", display=display.data_window)
plot(pwkOn ? pwL : na, "Prior week low",  display=display.data_window)

// ── VWAP (group 14) ─────────────────────────────────────────────────
// Anchored volume-weighted average price with stdev bands, accumulated
// manually so the anchor can be a day, a week, or one of group 01's
// session opens. Display and export only: never feeds the arming logic.

string vwSessStr = vwapAnchor == "NY session" ? nySess : vwapAnchor == "London session" ? loSess : asSess
bool vwInSess  = not na(time(timeframe.period, vwSessStr, tzNY))
bool vwSessOpen = vwInSess and not vwInSess[1]
bool vwReset = vwapAnchor == "Day" ? newDayBar : vwapAnchor == "Week" ? newWeekBar : vwSessOpen

var float vwSumPV  = 0.0
var float vwSumV   = 0.0
var float vwSumPV2 = 0.0
if vwReset
    vwSumPV  := 0.0
    vwSumV   := 0.0
    vwSumPV2 := 0.0
float vwSrc = hlc3
float vwVol = nz(volume)
if vwVol > 0
    vwSumPV  += vwSrc * vwVol
    vwSumV   += vwVol
    vwSumPV2 += vwSrc * vwSrc * vwVol

float vwapVal = vwSumV > 0 ? vwSumPV / vwSumV : na
float vwVar   = vwSumV > 0 ? math.max(vwSumPV2 / vwSumV - vwapVal * vwapVal, 0.0) : na
float vwSd    = math.sqrt(vwVar)

plot(vwapOn ? vwapVal : na, "VWAP", color=color.new(colVwap, 0), linewidth=2, style=plot.style_linebr)
plot(vwapOn and vwapBand1 ? vwapVal + vwapMult1 * vwSd : na, "VWAP +1 band", color=color.new(colVwBand, 40), style=plot.style_linebr)
plot(vwapOn and vwapBand1 ? vwapVal - vwapMult1 * vwSd : na, "VWAP -1 band", color=color.new(colVwBand, 40), style=plot.style_linebr)
plot(vwapOn and vwapBand2 ? vwapVal + vwapMult2 * vwSd : na, "VWAP +2 band", color=color.new(colVwBand, 60), style=plot.style_linebr)
plot(vwapOn and vwapBand2 ? vwapVal - vwapMult2 * vwSd : na, "VWAP -2 band", color=color.new(colVwBand, 60), style=plot.style_linebr)
// export: signed distance from VWAP in points, for the threshold test bench
plot(vwapOn ? close - vwapVal : na, "VWAP: close minus vwap (points)", display=display.data_window)
