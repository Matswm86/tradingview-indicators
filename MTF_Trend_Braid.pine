// ─────────────────────────────────────────────────────────────────────────────
//  MTF TREND BRAID  ·  Pine v6
//
//  Three gradient ribbons in one pane, one per timeframe (fast / medium / slow).
//  Each ribbon's vertical POSITION is driven by its own trend, and the lane
//  separation between them is multiplied by an agreement factor — the ribbons
//  only close the gap and braid when the timeframes genuinely align (same
//  direction, past a strength floor, converged). Inside a confirmed alignment
//  the three are overdrawn as ONE fused band and the individuals drop to ghosts.
//
//  Ribbon thickness = trend strength.  Hue = direction.  Opacity = conviction.
//  Body colour runs a true gradient: neutral grey at zero strength, full hue
//  at |trend| = 1.
//
//  Trend engine: L.A. Little's qualified-trend model ("Trend Qualification and
//  Trading", corpus book 0397). Per timeframe: a swing point actualises when it
//  survives 6 bars (Little's rule); the trend turns bullish when price CLOSES
//  above the last swing point high, bearish on a close below the last swing
//  point low, and must pass through sideways (0) when the break goes against
//  the standing trend — sideways is the buffer state (Little ch.3, Steidlmayer
//  directional-integrity, corpus book 0365). Volume at the breaking bar vs
//  volume at the broken swing bar qualifies the trend: expansion = CONFIRMED
//  (±1.0), contraction = SUSPECT (±0.6) — Little's six trend states. A small
//  dealing-range term (price vs the midpoint of the last swing high/low range,
//  the iFVG model's premium/discount) modulates the score by ±0.15.
// ─────────────────────────────────────────────────────────────────────────────

//@version=6
indicator("MTF Trend Braid", "MTF BRAID", overlay = false)

// ── inputs ───────────────────────────────────────────────────────────────────
gTF = "Timeframes"
tfFast = input.timeframe("5",   "Fast",   group = gTF)
tfMid  = input.timeframe("15",  "Medium", group = gTF)
tfSlow = input.timeframe("240", "Slow",   group = gTF)

gEng = "Trend engine (L.A. Little qualified-trend)"
spLen    = input.int(6, "Swing point actualisation bars", minval = 2, group = gEng,
     tooltip = "Little's rule: a swing survives this many bars on each side before it counts. 6 is the book's number.")
wSuspect = input.float(0.6, "Suspect trend weight", minval = 0.1, maxval = 1, step = 0.05, group = gEng,
     tooltip = "Score for a swing break on CONTRACTING volume (suspect trend). A break on expanding volume scores 1.0 (confirmed).")
wRange   = input.float(0.15, "Dealing-range modulation", minval = 0, maxval = 0.5, step = 0.05, group = gEng,
     tooltip = "Adds price position within the last swing-high/low range (premium/discount) so the ribbon breathes between breaks.")
floorIn  = input.float(0.35, "Strength floor", minval = 0, maxval = 1, step = 0.05, group = gEng,
     tooltip = "Every timeframe must exceed this |trend| before an alignment can qualify. 0.35 lets suspect trends (0.6) through; raise past 0.60 to demand volume-confirmed trends only.")
convIn   = input.float(0.22, "Convergence limit", minval = 0.01, maxval = 1, step = 0.01, group = gEng,
     tooltip = "Max spread (std-dev) between the three trend scores for an alignment to qualify. 0.22 allows mixed confirmed/suspect; lower it to demand the same qualification tier on all three.")
noRepaint = input.bool(true, "Wait for higher-TF bar close", group = gEng)

gVis = "Look"
colUp    = input.color(#E3C27E, "Long",  group = gVis)
colDn    = input.color(#7E8CFF, "Short", group = gVis)
laneGap  = input.float(1.6, "Lane separation",  minval = 0, step = 0.1, group = gVis)
amp      = input.float(1.0, "Trend deflection", minval = 0, step = 0.1, group = gVis)
showFuse = input.bool(true, "Fuse ribbons when aligned", group = gVis)
showMark = input.bool(true, "Direction marker on alignment", group = gVis)
showHud  = input.bool(false, "Show pane HUD (use the companion overlay HUD for the main chart)", group = gVis)

// ── trend engine: Little's qualified-trend state machine (returns −1 … +1) ───
//  +1.0 confirmed bullish · +0.6 suspect bullish · 0 sideways
//  −0.6 suspect bearish   · −1.0 confirmed bearish
//  ± up to `wRange` from position inside the last swing-to-swing range.
trendExpr() =>
    float ph = ta.pivothigh(high, spLen, spLen)
    float pl = ta.pivotlow(low,  spLen, spLen)

    var float sphP = na
    var float sphV = na
    var bool  sphLive = false
    var float splP = na
    var float splV = na
    var bool  splLive = false
    var int   dir  = 0
    var float qual = wSuspect

    if not na(ph)
        sphP := ph
        sphV := volume[spLen]
        sphLive := true
    if not na(pl)
        splP := pl
        splV := volume[spLen]
        splLive := true

    // a CLOSE through a live swing point is the trend event (Little ch.3).
    // A break against the standing trend only takes it to sideways first.
    if sphLive and close > sphP
        dir := dir < 0 ? 0 : 1
        if dir == 1
            qual := volume > sphV ? 1.0 : wSuspect
        sphLive := false
    if splLive and close < splP
        dir := dir > 0 ? 0 : -1
        if dir == -1
            qual := volume > splV ? 1.0 : wSuspect
        splLive := false

    // premium/discount inside the dealing range (iFVG model)
    float pos = not na(sphP) and not na(splP) and sphP != splP ?
         math.max(-1.0, math.min(1.0, (close - (sphP + splP) / 2) / (math.abs(sphP - splP) / 2))) : 0.0

    math.max(-1.0, math.min(1.0, (dir == 0 ? 0.0 : dir * qual) + wRange * pos))

// ── higher-timeframe reads ───────────────────────────────────────────────────
rawF = request.security(syminfo.tickerid, tfFast, trendExpr(), barmerge.gaps_off, barmerge.lookahead_off)
rawM = request.security(syminfo.tickerid, tfMid,  trendExpr(), barmerge.gaps_off, barmerge.lookahead_off)
rawS = request.security(syminfo.tickerid, tfSlow, trendExpr(), barmerge.gaps_off, barmerge.lookahead_off)

noRep(src) =>
    noRepaint ? (barstate.isrealtime ? src[1] : src) : src

tF = nz(noRep(rawF))
tM = nz(noRep(rawM))
tS = nz(noRep(rawS))

// ── agreement ────────────────────────────────────────────────────────────────
mean = (tF + tM + tS) / 3
sd   = math.sqrt(((tF - mean) * (tF - mean) + (tM - mean) * (tM - mean) + (tS - mean) * (tS - mean)) / 3)

allUp   = tF >  floorIn and tM >  floorIn and tS >  floorIn
allDn   = tF < -floorIn and tM < -floorIn and tS < -floorIn
sameDir = allUp ? 1 : allDn ? -1 : 0
aligned = sameDir != 0 and sd < convIn

// lanes may ONLY close on bars that qualify — this is what makes convergence
// mean the same thing the alert means
sep = sameDir != 0 ? math.max(0.10, math.min(0.66, sd * 3.2)) : math.max(0.66, 1.0 - 0.2 * math.min(1.0, sd * 2.4))

// ── geometry ─────────────────────────────────────────────────────────────────
yS =  laneGap * sep + tS * amp      // slow on top
yM =                  tM * amp      // medium centre
yF = -laneGap * sep + tF * amp      // fast on the bottom

thk(v) => 0.22 + 0.38 * math.abs(v)

// ── colour ───────────────────────────────────────────────────────────────────
hue(v)  => v >= 0 ? colUp : colDn
grad(v) => color.from_gradient(math.abs(v), 0.0, 1.0, color.new(#7C878E, 0), hue(v))
body(v) => color.new(grad(v), math.round((aligned and showFuse ? 88 : 68) + (1 - math.abs(v)) * 10))
edge(v) => color.new(hue(v),  aligned and showFuse ? 58 : math.round(18 + (1 - math.abs(v)) * 42))

dirCol = sameDir > 0 ? colUp : colDn

// ── ribbons ──────────────────────────────────────────────────────────────────
pST = plot(yS + thk(tS) / 2, "Slow top",    color = edge(tS), linewidth = 1)
pSB = plot(yS - thk(tS) / 2, "Slow bottom", color = edge(tS), linewidth = 1)
fill(pST, pSB, color = body(tS), title = "Slow ribbon")

pMT = plot(yM + thk(tM) / 2, "Medium top",    color = edge(tM), linewidth = 1)
pMB = plot(yM - thk(tM) / 2, "Medium bottom", color = edge(tM), linewidth = 1)
fill(pMT, pMB, color = body(tM), title = "Medium ribbon")

pFT = plot(yF + thk(tF) / 2, "Fast top",    color = edge(tF), linewidth = 1)
pFB = plot(yF - thk(tF) / 2, "Fast bottom", color = edge(tF), linewidth = 1)
fill(pFT, pFB, color = body(tF), title = "Fast ribbon")

// ── the fuse: three ribbons drawn as one inside a confirmed alignment ────────
fuseOn  = aligned and showFuse
topAll  = math.max(yS + thk(tS) / 2, yM + thk(tM) / 2, yF + thk(tF) / 2)
botAll  = math.min(yS - thk(tS) / 2, yM - thk(tM) / 2, yF - thk(tF) / 2)

pZT = plot(fuseOn ? topAll : na, "Fuse top",    color = fuseOn ? dirCol : na, linewidth = 2)
pZB = plot(fuseOn ? botAll : na, "Fuse bottom", color = fuseOn ? dirCol : na, linewidth = 2)
fill(pZT, pZB, color = fuseOn ? color.new(dirCol, 50) : na, title = "Fused band")

// ── axis, pane scale ─────────────────────────────────────────────────────────
hline(0, "Axis", color = color.new(color.gray, 72), linestyle = hline.style_solid)

// keeps the pane from rescaling as the braid moves
plot( laneGap + amp + 0.6, "Scale pin +", color = color.new(color.gray, 100), editable = false)
plot(-laneGap - amp - 0.6, "Scale pin -", color = color.new(color.gray, 100), editable = false)

flipped(v) => math.sign(v) != math.sign(v[1])

// ── direction marker: prints ONCE when an alignment starts ───────────────────
alignStart = aligned and not aligned[1]
if showMark and alignStart
    mLbl = label.new(bar_index, sameDir > 0 ? botAll - 0.35 : topAll + 0.35,
         sameDir > 0 ? "LONG ▲" : "SHORT ▼",
         style = sameDir > 0 ? label.style_label_up : label.style_label_down,
         color = color.new(dirCol, 12), textcolor = #0A0B0D, size = size.small)

// ── HUD ──────────────────────────────────────────────────────────────────────
meter(v) =>
    filled = math.max(1, math.round(math.abs(v) * 7))
    str.repeat("▮", filled) + str.repeat("▯", 7 - filled)

// ✓ marks a volume-CONFIRMED trend (score past 0.8); no mark = suspect trend
word(v) => math.abs(v) < 0.18 ? "FLAT" : (v >= 0 ? "LONG" : "SHORT") + (math.abs(v) > 0.8 ? " ✓" : "")
txt(v)  => math.abs(v) < 0.18 ? color.new(color.gray, 20) : hue(v)

cntUp = (tF > 0.3 ? 1 : 0) + (tM > 0.3 ? 1 : 0) + (tS > 0.3 ? 1 : 0)
cntDn = (tF < -0.3 ? 1 : 0) + (tM < -0.3 ? 1 : 0) + (tS < -0.3 ? 1 : 0)
votes = aligned ? 3 : math.min(2, math.max(cntUp, cntDn))

var table hud = table.new(position.top_right, 3, 4, bgcolor = color.new(#0A0B0D, 6), frame_color = #1A1D21, frame_width = 1, border_width = 0)

if showHud and barstate.islast
    gate = str.repeat("▰", votes) + str.repeat("▱", 3 - votes)
    table.cell(hud, 0, 0, "MTF",  text_color = #5E666E, text_size = size.tiny, text_halign = text.align_left)
    table.cell(hud, 1, 0, gate,   text_color = votes == 3 ? dirCol : #4E585F, text_size = size.tiny)
    table.cell(hud, 2, 0, str.tostring(votes) + "/3", text_color = votes == 3 ? dirCol : #7C878E, text_size = size.tiny, text_halign = text.align_right)

    table.cell(hud, 0, 1, tfSlow, text_color = #7C878E, text_size = size.tiny, text_halign = text.align_left)
    table.cell(hud, 1, 1, meter(tS), text_color = txt(tS), text_size = size.tiny)
    table.cell(hud, 2, 1, flipped(tS) ? "FLIP" : word(tS), text_color = txt(tS), text_size = size.tiny, text_halign = text.align_right)

    table.cell(hud, 0, 2, tfMid, text_color = #7C878E, text_size = size.tiny, text_halign = text.align_left)
    table.cell(hud, 1, 2, meter(tM), text_color = txt(tM), text_size = size.tiny)
    table.cell(hud, 2, 2, flipped(tM) ? "FLIP" : word(tM), text_color = txt(tM), text_size = size.tiny, text_halign = text.align_right)

    table.cell(hud, 0, 3, tfFast, text_color = #7C878E, text_size = size.tiny, text_halign = text.align_left)
    table.cell(hud, 1, 3, meter(tF), text_color = txt(tF), text_size = size.tiny)
    table.cell(hud, 2, 3, flipped(tF) ? "FLIP" : word(tF), text_color = txt(tF), text_size = size.tiny, text_halign = text.align_right)

// ── alerts ───────────────────────────────────────────────────────────────────
braidLong  = aligned and sameDir > 0 and not (aligned[1] and sameDir[1] > 0)
braidShort = aligned and sameDir < 0 and not (aligned[1] and sameDir[1] < 0)
braidBroke = not aligned and aligned[1]

alertcondition(braidLong,  "Braid · aligned long",  "All three timeframes aligned LONG")
alertcondition(braidShort, "Braid · aligned short", "All three timeframes aligned SHORT")
alertcondition(braidBroke, "Braid · broken",        "Timeframe alignment lost")
alertcondition(flipped(tF), "Flip · fast",   "Fast timeframe flipped")
alertcondition(flipped(tM), "Flip · medium", "Medium timeframe flipped")
alertcondition(flipped(tS), "Flip · slow",   "Slow timeframe flipped")
