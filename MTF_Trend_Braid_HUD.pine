// ─────────────────────────────────────────────────────────────────────────────
//  MTF TREND BRAID · HUD  ·  Pine v6  ·  overlay companion
//
//  Same trend engine and alignment logic as MTF_Trend_Braid.pine, but drawn as
//  a table on the MAIN chart (Pine cannot project a pane indicator's table
//  onto the price panel, so the HUD lives in this separate overlay script).
//  Keep the inputs identical on both scripts or the HUD and the braid will
//  disagree.
// ─────────────────────────────────────────────────────────────────────────────

//@version=6
indicator("MTF Trend Braid · HUD", "BRAID HUD", overlay = true)

// ── inputs (mirror the braid) ────────────────────────────────────────────────
gTF = "Timeframes"
tfFast = input.timeframe("5",   "Fast",   group = gTF)
tfMid  = input.timeframe("15",  "Medium", group = gTF)
tfSlow = input.timeframe("240", "Slow",   group = gTF)

gEng = "Trend engine (L.A. Little qualified-trend)"
spLen    = input.int(6, "Swing point actualisation bars", minval = 2, group = gEng)
wSuspect = input.float(0.6, "Suspect trend weight", minval = 0.1, maxval = 1, step = 0.05, group = gEng)
wRange   = input.float(0.15, "Dealing-range modulation", minval = 0, maxval = 0.5, step = 0.05, group = gEng)
floorIn  = input.float(0.35, "Strength floor", minval = 0, maxval = 1, step = 0.05, group = gEng)
convIn   = input.float(0.22, "Convergence limit", minval = 0.01, maxval = 1, step = 0.01, group = gEng)
noRepaint = input.bool(true, "Wait for higher-TF bar close", group = gEng)

gVis = "Look"
colUp   = input.color(#E3C27E, "Long",  group = gVis)
colDn   = input.color(#7E8CFF, "Short", group = gVis)
hudPos  = input.string("Top right", "HUD position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = gVis)
hudBig  = input.bool(true, "Large text", group = gVis)

// ── trend engine: Little's qualified-trend state machine (identical to braid) ─
//  +1.0 confirmed bullish · +0.6 suspect bullish · 0 sideways
//  −0.6 suspect bearish   · −1.0 confirmed bearish
//  ± up to `wRange` from position inside the last swing-to-swing range.
trendExpr() =>
    float ph = ta.pivothigh(high, spLen, spLen)
    float pl = ta.pivotlow(low,  spLen, spLen)

    var float sphP = na
    var float sphV = na
    var bool  sphLive = false
    var float splP = na
    var float splV = na
    var bool  splLive = false
    var int   dir  = 0
    var float qual = wSuspect

    if not na(ph)
        sphP := ph
        sphV := volume[spLen]
        sphLive := true
    if not na(pl)
        splP := pl
        splV := volume[spLen]
        splLive := true

    if sphLive and close > sphP
        dir := dir < 0 ? 0 : 1
        if dir == 1
            qual := volume > sphV ? 1.0 : wSuspect
        sphLive := false
    if splLive and close < splP
        dir := dir > 0 ? 0 : -1
        if dir == -1
            qual := volume > splV ? 1.0 : wSuspect
        splLive := false

    float pos = not na(sphP) and not na(splP) and sphP != splP ?
         math.max(-1.0, math.min(1.0, (close - (sphP + splP) / 2) / (math.abs(sphP - splP) / 2))) : 0.0

    math.max(-1.0, math.min(1.0, (dir == 0 ? 0.0 : dir * qual) + wRange * pos))

rawF = request.security(syminfo.tickerid, tfFast, trendExpr(), barmerge.gaps_off, barmerge.lookahead_off)
rawM = request.security(syminfo.tickerid, tfMid,  trendExpr(), barmerge.gaps_off, barmerge.lookahead_off)
rawS = request.security(syminfo.tickerid, tfSlow, trendExpr(), barmerge.gaps_off, barmerge.lookahead_off)

noRep(src) =>
    noRepaint ? (barstate.isrealtime ? src[1] : src) : src

tF = nz(noRep(rawF))
tM = nz(noRep(rawM))
tS = nz(noRep(rawS))

// ── agreement (identical to the braid) ───────────────────────────────────────
mean = (tF + tM + tS) / 3
sd   = math.sqrt(((tF - mean) * (tF - mean) + (tM - mean) * (tM - mean) + (tS - mean) * (tS - mean)) / 3)

allUp   = tF >  floorIn and tM >  floorIn and tS >  floorIn
allDn   = tF < -floorIn and tM < -floorIn and tS < -floorIn
sameDir = allUp ? 1 : allDn ? -1 : 0
aligned = sameDir != 0 and sd < convIn
dirCol  = sameDir > 0 ? colUp : colDn

// ── HUD ──────────────────────────────────────────────────────────────────────
posOpt = hudPos == "Top left" ? position.top_left : hudPos == "Bottom right" ? position.bottom_right : hudPos == "Bottom left" ? position.bottom_left : hudPos == "Middle right" ? position.middle_right : position.top_right
szTxt  = hudBig ? size.normal : size.small
szHead = hudBig ? size.large  : size.normal

hue(v) => v >= 0 ? colUp : colDn

meter(v) =>
    filled = math.max(1, math.round(math.abs(v) * 8))
    str.repeat("▮", filled) + str.repeat("▯", 8 - filled)

// ✓ marks a volume-CONFIRMED trend (score past 0.8); no mark = suspect trend
word(v) => math.abs(v) < 0.18 ? "FLAT" : (v >= 0 ? "LONG" : "SHORT") + (math.abs(v) > 0.8 ? " ✓" : "")
txt(v)  => math.abs(v) < 0.18 ? color.new(color.gray, 20) : hue(v)

cntUp = (tF > 0.3 ? 1 : 0) + (tM > 0.3 ? 1 : 0) + (tS > 0.3 ? 1 : 0)
cntDn = (tF < -0.3 ? 1 : 0) + (tM < -0.3 ? 1 : 0) + (tS < -0.3 ? 1 : 0)
votes = aligned ? 3 : math.min(2, math.max(cntUp, cntDn))

var table hud = table.new(posOpt, 3, 5, bgcolor = color.new(#0A0B0D, 6), frame_color = #1A1D21, frame_width = 1, border_width = 0)

if barstate.islast
    table.clear(hud, 0, 0, 2, 4)
    // headline row: the direction verdict, unmissable
    stateTxt = aligned ? (sameDir > 0 ? "▲ ALIGNED LONG" : "▼ ALIGNED SHORT") : "NO ALIGNMENT"
    stateCol = aligned ? dirCol : #7C878E
    table.cell(hud, 0, 0, stateTxt, text_color = stateCol, text_size = szHead, text_halign = text.align_center)
    table.merge_cells(hud, 0, 0, 2, 0)

    gate = str.repeat("▰", votes) + str.repeat("▱", 3 - votes)
    table.cell(hud, 0, 1, "VOTES", text_color = #5E666E, text_size = szTxt, text_halign = text.align_left)
    table.cell(hud, 1, 1, gate,    text_color = votes == 3 ? dirCol : #4E585F, text_size = szTxt)
    table.cell(hud, 2, 1, str.tostring(votes) + "/3", text_color = votes == 3 ? dirCol : #7C878E, text_size = szTxt, text_halign = text.align_right)

    table.cell(hud, 0, 2, tfSlow, text_color = #7C878E, text_size = szTxt, text_halign = text.align_left)
    table.cell(hud, 1, 2, meter(tS), text_color = txt(tS), text_size = szTxt)
    table.cell(hud, 2, 2, word(tS), text_color = txt(tS), text_size = szTxt, text_halign = text.align_right)

    table.cell(hud, 0, 3, tfMid, text_color = #7C878E, text_size = szTxt, text_halign = text.align_left)
    table.cell(hud, 1, 3, meter(tM), text_color = txt(tM), text_size = szTxt)
    table.cell(hud, 2, 3, word(tM), text_color = txt(tM), text_size = szTxt, text_halign = text.align_right)

    table.cell(hud, 0, 4, tfFast, text_color = #7C878E, text_size = szTxt, text_halign = text.align_left)
    table.cell(hud, 1, 4, meter(tF), text_color = txt(tF), text_size = szTxt)
    table.cell(hud, 2, 4, word(tF), text_color = txt(tF), text_size = szTxt, text_halign = text.align_right)
